---
interface Props {
  images?: string[];
  title: string;
}

const { images = [], title } = Astro.props;
const hasImages = images.length > 0;
const isMulti = images.length > 1;
const carouselId = `carousel-${Math.random().toString(36).substring(2, 9)}`;
---

{hasImages && (
  <div class="project-carousel mb-10 w-full" id={carouselId} data-total={images.length}>
    <!-- Main Display Viewport -->
    <div class="relative w-full aspect-video sm:aspect-[16/9] max-h-[520px] rounded-xl overflow-hidden border border-charcoal bg-obsidian/90 group shadow-2xl">
      
      <!-- Slide Track -->
      <div class="relative w-full h-full flex items-center justify-center overflow-hidden">
        {images.map((img, idx) => (
          <div 
            class={`carousel-slide absolute inset-0 w-full h-full flex items-center justify-center transition-opacity duration-300 ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
            data-index={idx}
          >
            <img 
              src={img} 
              alt={`${title} - Visual ${idx + 1}`}
              class="w-full h-full object-contain sm:object-cover bg-charcoal/20 select-none"
              loading={idx === 0 ? 'eager' : 'lazy'}
            />
          </div>
        ))}
      </div>

      <!-- Cyber Grid Overlay Corner Accents -->
      <div class="absolute top-2 left-2 font-mono text-[9px] text-titanium-muted/40 pointer-events-none z-20 hidden sm:block">
        ┌ SYSTEM VISUAL STREAM //
      </div>
      <div class="absolute bottom-2 right-2 font-mono text-[9px] text-titanium-muted/40 pointer-events-none z-20 hidden sm:block">
        // 4K ARCHIVE STREAM ┘
      </div>

      {isMulti && (
        <>
          <!-- Slide Counter Badge -->
          <div class="absolute top-3 right-3 z-20 font-mono text-xs px-2.5 py-1 rounded bg-obsidian/85 border border-charcoal/80 text-titanium backdrop-blur-md">
            <span class="current-slide-num text-gold font-bold">01</span>
            <span class="text-titanium-muted"> / </span>
            <span class="text-titanium-muted">{String(images.length).padStart(2, '0')}</span>
          </div>

          <!-- Navigation Arrow Buttons -->
          <button 
            type="button"
            class="prev-btn absolute left-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-obsidian/80 border border-charcoal text-titanium hover:text-gold hover:border-gold hover:bg-obsidian transition-all flex items-center justify-center backdrop-blur-sm opacity-80 hover:opacity-100 focus:outline-none"
            aria-label="Previous image"
          >
            <span class="font-mono text-base font-bold">‹</span>
          </button>

          <button 
            type="button"
            class="next-btn absolute right-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-obsidian/80 border border-charcoal text-titanium hover:text-gold hover:border-gold hover:bg-obsidian transition-all flex items-center justify-center backdrop-blur-sm opacity-80 hover:opacity-100 focus:outline-none"
            aria-label="Next image"
          >
            <span class="font-mono text-base font-bold">›</span>
          </button>
        </>
      )}
    </div>

    <!-- Thumbnail Strip (Only shown if multiple images) -->
    {isMulti && (
      <div class="flex items-center gap-3 mt-3 overflow-x-auto pb-2 custom-scrollbar">
        {images.map((img, idx) => (
          <button
            type="button"
            class={`thumb-btn relative flex-shrink-0 w-20 h-14 sm:w-24 sm:h-16 rounded-lg overflow-hidden border transition-all duration-200 ${idx === 0 ? 'border-gold ring-2 ring-gold/30 opacity-100' : 'border-charcoal opacity-50 hover:opacity-100 hover:border-titanium-muted'}`}
            data-index={idx}
            aria-label={`View image ${idx + 1}`}
          >
            <img 
              src={img} 
              alt={`${title} thumb ${idx + 1}`}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </button>
        ))}
      </div>
    )}
  </div>
)}

<script>
  function initCarousels() {
    const carousels = document.querySelectorAll('.project-carousel');

    carousels.forEach(carousel => {
      const total = parseInt(carousel.getAttribute('data-total') || '1');
      if (total <= 1) return;

      const slides = carousel.querySelectorAll('.carousel-slide');
      const thumbs = carousel.querySelectorAll('.thumb-btn');
      const counterEl = carousel.querySelector('.current-slide-num');
      const prevBtn = carousel.querySelector('.prev-btn');
      const nextBtn = carousel.querySelector('.next-btn');

      let currentIndex = 0;

      function goToSlide(idx: number) {
        currentIndex = (idx + total) % total;

        slides.forEach((slide, i) => {
          if (i === currentIndex) {
            slide.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
            slide.classList.add('opacity-100', 'z-10');
          } else {
            slide.classList.remove('opacity-100', 'z-10');
            slide.classList.add('opacity-0', 'z-0', 'pointer-events-none');
          }
        });

        thumbs.forEach((thumb, i) => {
          if (i === currentIndex) {
            thumb.classList.add('border-gold', 'ring-2', 'ring-gold/30', 'opacity-100');
            thumb.classList.remove('border-charcoal', 'opacity-50');
            thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          } else {
            thumb.classList.remove('border-gold', 'ring-2', 'ring-gold/30', 'opacity-100');
            thumb.classList.add('border-charcoal', 'opacity-50');
          }
        });

        if (counterEl) {
          counterEl.textContent = String(currentIndex + 1).padStart(2, '0');
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          goToSlide(currentIndex - 1);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          goToSlide(currentIndex + 1);
        });
      }

      thumbs.forEach(thumb => {
        thumb.addEventListener('click', (e) => {
          e.preventDefault();
          const targetIdx = parseInt(thumb.getAttribute('data-index') || '0');
          goToSlide(targetIdx);
        });
      });
    });
  }

  // Initialize on page load and dynamic transitions
  document.addEventListener('DOMContentLoaded', initCarousels);
  initCarousels();
</script>
