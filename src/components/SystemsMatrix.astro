---
const systems = [
  {
    category: "STRATEGY & VENTURE DESIGN",
    color: "text-gold",
    border: "border-gold/30 bg-gold/10",
    accentGlow: "group-hover:border-gold/50",
    items: [
      { name: "Zero-to-One Incubation", desc: "MSc in Innovation & Entrepreneurship (HEC Paris). Building unit economic models, venture narratives, and customer discovery loops." },
      { name: "Executive Platform Alignment", desc: "Aligning C-suite leadership, practice heads, and engineering across complex multi-BU platforms (PwC Sightline, Coinbase Cloud)." },
      { name: "High-Stakes & Regulated Markets", desc: "Navigating deep compliance requirements across healthcare (HIPAA), fintech/banking (Visa), and enterprise audit (PwC)." },
    ]
  },
  {
    category: "INTERACTION IP & CREATIVE TECH",
    color: "text-cyan",
    border: "border-cyan/30 bg-cyan/10",
    accentGlow: "group-hover:border-cyan/50",
    items: [
      { name: "6 US Utility Patents", desc: "Patented interaction methodologies bridging touch choreography, real-time shaders, and media state synchronization." },
      { name: "Conversational & Voice UX", desc: "Designed award-winning voice agents (Destiny 2 Ghost Alexa Skill); Cannes Silver Lion, Gold Clio, GDC speaker." },
      { name: "Physical & Spatial Computing", desc: "Bespoke hardware breadboards, RFID/BLE IoT, and projection mapping from Disney MagicBand to Nike retail." },
    ]
  },
  {
    category: "FRONTIER AI & HIGH-COMPUTE",
    color: "text-magenta",
    border: "border-magenta/30 bg-magenta/10",
    accentGlow: "group-hover:border-magenta/50",
    items: [
      { name: "Agent Runtimes & Evals", desc: "Architecting audit-ready, HIPAA-compliant generative AI agent frameworks and automated synthetic eval harnesses." },
      { name: "5x Engineering Velocity", desc: "Accelerating engineering teams through modern agentic workflows, automated test scaffolding, and continuous delivery loops." },
      { name: "Bare-Metal Supercomputing", desc: "Orchestrating high-density compute clusters (72 DGX-2s off-grid), power SLAs, and sustainable AI infrastructure." },
    ]
  }
];
---

<section id="systems" class="max-w-7xl mx-auto px-6 py-20 border-t border-charcoal/80">
  <!-- Clean Single Header with Grounded Telemetry Description Panel on Right -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-8 mb-16">
    <div>
      <h2 class="text-3xl md:text-5xl font-display font-bold tracking-tight heading-glow-cyan">
        Integrated Systems Matrix
      </h2>
    </div>
    
    <div class="punk-panel p-5 bg-[#0E1117]/85 border-l-2 border-l-cyan max-w-lg">
      <div class="flex items-center gap-2 font-mono text-xs text-cyan uppercase tracking-wider font-semibold mb-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan animate-pulse"></span>
        <span>CAPABILITY ARCHITECTURE</span>
      </div>
      <p class="text-titanium/80 text-xs sm:text-sm font-light leading-relaxed mb-0">
        Disciplines engineered to intersect: strategy feeds interface design, interface design drives technical architecture, and architecture delivers market outcomes.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {systems.map(system => (
      <div class={`punk-panel p-8 transition-all duration-300 ${system.accentGlow} relative flex flex-col justify-between group`}>
        <div>
          <div class="flex items-center justify-between pb-4 border-b border-charcoal/80 mb-6">
            <span class={`font-mono text-xs font-bold tracking-wider ${system.color}`}>
              // {system.category}
            </span>
            <span class="w-2 h-2 rounded-full bg-titanium/20 group-hover:bg-gold transition-colors"></span>
          </div>

          <div class="space-y-6">
            {system.items.map(item => (
              <div class="border-b border-charcoal/40 pb-5 last:border-b-0 last:pb-0">
                <h3 class="font-display font-bold text-base text-titanium mb-1.5 group-hover:text-gold transition-colors flex items-center gap-2">
                  <span class="text-gold text-xs">▹</span>
                  {item.name}
                </h3>
                <p class="text-xs text-titanium/80 leading-relaxed font-light pl-4">
                  {item.desc}
                </p>
              </div>
            ))}
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-charcoal/60 flex items-center justify-between font-mono text-[11px] text-titanium-muted">
          <span>STATUS: PRODUCTION_READY</span>
          <span class="text-gold">● ACTIVE</span>
        </div>
      </div>
    ))}
  </div>
</section>
