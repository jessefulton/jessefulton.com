---
const systems = [
  {
    category: "VOICE & MULTIMODAL UX",
    tagColor: "text-cyan",
    items: [
      { name: "Conversational Architecture", desc: "Designed award-winning voice agents and multimodal user flows with 10+ years hands-on field experience." },
      { name: "6 Human-Machine Patents", desc: "Patented interaction methodologies bridging voice, vision, and real-time state synchronization." },
      { name: "Audio-Spatial Experience", desc: "Interactive audio engines, GDC-featured speaker on game/voice integration." },
    ]
  },
  {
    category: "VENTURE & PRODUCT STRATEGY",
    tagColor: "text-gold",
    items: [
      { name: "Zero-to-One Incubation", desc: "From whiteboard concept to market viability, building business models and pitch narratives." },
      { name: "Enterprise Workshopping", desc: "Aligning executive leadership, product managers, and engineering teams on high-stakes roadmaps." },
      { name: "Founder Mentorship", desc: "Active startup mentoring with the Santa Cruz Launchpad accelerator ecosystem." },
    ]
  },
  {
    category: "FRONTIER AI & SYSTEM VELOCITY",
    tagColor: "text-magenta",
    items: [
      { name: "Agent Runtime & Evals", desc: "Building deterministic evaluation harnesses, guardrails, and HIPAA-compliant generative pipelines." },
      { name: "5x Developer Velocity", desc: "Implementing modern AI workflows, automated test scaffolding, and continuous delivery loops." },
      { name: "Full-Stack & Edge Delivery", desc: "Ultra-fast modern web applications, Astro, Netlify, Cloudflare Workers, and distributed state." },
    ]
  }
];
---

<section id="systems" class="max-w-7xl mx-auto px-6 py-20 border-t border-charcoal">
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
    <div>
      <div class="font-mono text-xs text-cyan tracking-widest uppercase mb-2">
        // SYSTEM ARCHITECTURE & METHODOLOGY
      </div>
      <h2 class="text-3xl md:text-4xl font-display font-bold text-titanium tracking-tight">
        Integrated Systems Matrix
      </h2>
    </div>
    <div class="font-mono text-xs text-titanium-muted flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-lime"></span>
      <span>ACTIVE STATUS: FULL OPERATIONAL INTEGRITY</span>
    </div>
  </div>

  <!-- Systems Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    {systems.map((system) => (
      <div class="rounded-xl border border-charcoal bg-obsidian/90 p-6 flex flex-col justify-between">
        <div>
          <div class={`font-mono text-xs font-bold tracking-wider mb-6 pb-3 border-b border-charcoal ${system.tagColor}`}>
            // {system.category}
          </div>
          
          <div class="space-y-6">
            {system.items.map((item) => (
              <div class="group">
                <h4 class="font-display font-semibold text-titanium text-base group-hover:text-gold transition-colors flex items-center gap-2">
                  <span class="font-mono text-xs text-titanium-muted">▹</span> {item.name}
                </h4>
                <p class="text-xs text-titanium-muted font-light leading-relaxed mt-1.5 pl-4 border-l border-charcoal group-hover:border-gold/40 transition-colors">
                  {item.desc}
                </p>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-charcoal/50 flex justify-between items-center text-[11px] font-mono text-titanium-muted">
          <span>OPERATOR_READY</span>
          <span class="text-cyan">✔ COMPILED</span>
        </div>
      </div>
    ))}
  </div>
</section>
