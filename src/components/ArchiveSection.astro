---
const featuredWorks = [
  {
    title: "Destiny 2 Ghost Alexa Skill",
    client: "Activision / Bungie / AKQA",
    category: "VOICE UX & MULTIMODAL",
    tagColor: "text-cyan border-cyan/30 bg-cyan/10",
    description: "Pioneering real-time game-to-voice companion. Winner of Cannes Gold/Silver Lions, Gold Clios, and featured keynote at GDC.",
    metrics: "Cannes Lions, Clios, Global Reach",
  },
  {
    title: "Frontier AI Agent Harnesses",
    client: "Thrive AI Health",
    category: "AI & SYSTEMS VELOCITY",
    tagColor: "text-lime border-lime/30 bg-lime/10",
    description: "Architected HIPAA-compliant generative AI agent frameworks, evaluation suites, and engineering infrastructure yielding 5x development velocity.",
    metrics: "5x Velocity, Zero-to-One",
  },
  {
    title: "Coinbase Cloud Strategy & Workshopping",
    client: "Coinbase / YML / Code & Theory",
    category: "ENTERPRISE PRODUCT STRATEGY",
    tagColor: "text-gold border-gold/30 bg-gold/10",
    description: "Executive product strategy and interactive workshopping aligning product vision, developer experience, and go-to-market execution.",
    metrics: "Executive Alignment & DX",
  },
  {
    title: "Software as Art & Interactive Exhibits",
    client: "Zero1, Eyebeam, The Creators Project",
    category: "CREATIVE TECHNOLOGY & NEW MEDIA",
    tagColor: "text-magenta border-magenta/30 bg-magenta/10",
    description: "Interactive installations and generative software art exhibited internationally across Zero1 Festival, Eyebeam Art+Technology Center, and UCSC DANM.",
    metrics: "International Exhibitions, MFA",
  },
];

const archiveCategories = [
  "Voice & Conversational AI",
  "Enterprise Product Strategy",
  "Software Art & Creative Tech",
  "Zero-to-One Ventures",
  "Patents & Interaction Design"
];
---

<section id="archive" class="max-w-7xl mx-auto px-6 py-20 border-t border-charcoal">
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
    <div>
      <div class="font-mono text-xs text-magenta tracking-widest uppercase mb-2">
        // SELECTED WORKS & 20-YEAR ARCHIVE
      </div>
      <h2 class="text-3xl md:text-4xl font-display font-bold text-titanium tracking-tight">
        Featured Ventures & Exhibits
      </h2>
    </div>
    <p class="text-titanium-muted max-w-md text-sm font-light leading-relaxed">
      A curated selection bridging enterprise innovation, voice companion systems, and experimental creative coding.
    </p>
  </div>

  <!-- Featured Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
    {featuredWorks.map((work) => (
      <div class="rounded-xl border border-charcoal bg-charcoal/20 p-8 backdrop-blur-sm hover:border-gold/40 transition-all duration-300 group flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class={`font-mono text-[10px] px-2.5 py-1 rounded border ${work.tagColor}`}>
              {work.category}
            </span>
            <span class="font-mono text-xs text-titanium-muted">
              {work.client}
            </span>
          </div>

          <h3 class="text-2xl font-display font-bold text-titanium mb-3 group-hover:text-gold transition-colors">
            {work.title}
          </h3>

          <p class="text-sm text-titanium/80 font-light leading-relaxed mb-6">
            {work.description}
          </p>
        </div>

        <div class="pt-4 border-t border-charcoal/60 flex items-center justify-between font-mono text-xs text-titanium-muted">
          <span>{work.metrics}</span>
          <span class="text-gold group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </div>
    ))}
  </div>

  <!-- Archive Summary Banner -->
  <div class="rounded-xl border border-charcoal/80 bg-obsidian p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6">
    <div>
      <div class="font-display font-bold text-titanium text-lg mb-1">
        Explore the Complete 30+ Project Archive
      </div>
      <p class="text-xs text-titanium-muted font-light">
        Includes thesis research (DANM), early web experiments, retail interactive installations, and digital art.
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      {archiveCategories.map((cat) => (
        <span class="font-mono text-[11px] px-3 py-1.5 rounded bg-charcoal/40 border border-charcoal text-titanium/80">
          {cat}
        </span>
      ))}
    </div>
  </div>
</section>
