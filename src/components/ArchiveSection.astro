---
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredWorks = allProjects.filter(p => p.data.featured).slice(0, 4);

const categoryConfig: Record<string, { label: string; color: string; border: string }> = {
  'frontier-ai': { label: 'FRONTIER AI & SYSTEMS', color: 'text-cyan', border: 'border-cyan/40 bg-cyan/10' },
  'venture-strategy': { label: 'VENTURE & STRATEGY', color: 'text-gold', border: 'border-gold/40 bg-gold/10' },
  'experiential-spatial': { label: 'EXPERIENTIAL & SPATIAL', color: 'text-magenta', border: 'border-magenta/40 bg-magenta/10' },
  'creative-tech': { label: 'CREATIVE TECH & ART', color: 'text-lime', border: 'border-lime/40 bg-lime/10' },
};
---

<section id="archive" class="max-w-7xl mx-auto px-6 py-20 border-t border-charcoal">
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
    <div>
      <div class="font-mono text-xs text-magenta tracking-widest uppercase mb-2">
        // SELECTED WORKS & VENTURES
      </div>
      <h2 class="text-3xl md:text-4xl font-display font-bold text-titanium tracking-tight">
        Featured Case Studies
      </h2>
    </div>
    <div class="flex items-center gap-4">
      <a 
        href="/portfolio" 
        class="font-mono text-xs px-4 py-2 rounded border border-charcoal bg-charcoal/30 text-titanium hover:border-gold hover:text-gold transition-all duration-200"
      >
        [ VIEW ALL {allProjects.length} ARCHIVES → ]
      </a>
    </div>
  </div>

  <!-- Featured Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
    {featuredWorks.map((work) => {
      const cat = categoryConfig[work.data.category] || { label: work.data.category, color: 'text-titanium', border: 'border-charcoal bg-charcoal/20' };
      return (
        <a 
          href={`/portfolio/${work.slug}`}
          class="rounded-xl border border-charcoal bg-charcoal/20 p-8 backdrop-blur-sm hover:border-gold/50 hover:bg-charcoal/40 transition-all duration-300 group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class={`font-mono text-[10px] px-2.5 py-1 rounded border ${cat.border} ${cat.color} font-medium`}>
                {cat.label}
              </span>
              <span class="font-mono text-xs text-titanium-muted">
                {work.data.client || work.data.employer || work.data.year}
              </span>
            </div>

            <h3 class="text-2xl font-display font-bold text-titanium mb-3 group-hover:text-gold transition-colors">
              {work.data.title}
            </h3>

            <p class="text-sm text-titanium/80 font-light leading-relaxed mb-6">
              {work.data.briefDescription}
            </p>
          </div>

          <div class="pt-4 border-t border-charcoal/60 flex items-center justify-between font-mono text-xs text-titanium-muted">
            <div class="flex gap-2">
              {work.data.metrics && work.data.metrics.slice(0, 2).map(m => (
                <span class="text-cyan">⚡ {m}</span>
              ))}
            </div>
            <span class="text-gold group-hover:translate-x-1 transition-transform">READ STUDY →</span>
          </div>
        </a>
      );
    })}
  </div>

  <!-- Archive Summary Banner -->
  <div class="rounded-xl border border-charcoal/80 bg-obsidian p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6">
    <div>
      <div class="font-display font-bold text-titanium text-lg mb-1">
        20-Year Retrospective Catalog
      </div>
      <p class="text-xs text-titanium-muted font-light">
        Includes Master's thesis research (DANM), early web experiments, interactive spatial retail installations, and generative software art.
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <a href="/portfolio?category=frontier-ai" class="font-mono text-[11px] px-3 py-1.5 rounded bg-charcoal/40 border border-charcoal text-cyan hover:border-cyan">
        [ Frontier AI ]
      </a>
      <a href="/portfolio?category=venture-strategy" class="font-mono text-[11px] px-3 py-1.5 rounded bg-charcoal/40 border border-charcoal text-gold hover:border-gold">
        [ Venture & Strategy ]
      </a>
      <a href="/portfolio?category=experiential-spatial" class="font-mono text-[11px] px-3 py-1.5 rounded bg-charcoal/40 border border-charcoal text-magenta hover:border-magenta">
        [ Experiential & Spatial ]
      </a>
      <a href="/portfolio?category=creative-tech" class="font-mono text-[11px] px-3 py-1.5 rounded bg-charcoal/40 border border-charcoal text-lime hover:border-lime">
        [ Creative Tech ]
      </a>
    </div>
  </div>
</section>
