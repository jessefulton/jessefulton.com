---

<section class="max-w-7xl mx-auto px-6 pt-12 md:pt-20 pb-20 relative">
  
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    
    <!-- Left Column: Editorial Headline Carousel & Narrative (7 Columns) -->
    <div class="lg:col-span-7 flex flex-col justify-center">
      
      <!-- Eyebrow: Special Elite Stamp + Rock Salt Hand-Scribble -->
      <div class="flex items-center gap-3 mb-6 flex-wrap">
        <span class="stamp-bw">
          <span class="w-2 h-2 rounded-full bg-magenta animate-pulse inline-block mr-1"></span>
          EXECUTIVE VENTURE ARCHITECTURE
        </span>
        <span class="hand-scribble text-gold rotate-1 hidden sm:inline-block">
          ~ 20 years in tech without losing the soul
        </span>
      </div>

      <!-- Headline Area with Auto-Rotating Statements & Colored Marker Underlines -->
      <div class="relative min-h-[150px] sm:min-h-[170px] md:min-h-[190px] mb-4">
        <div id="slide-0" class="carousel-slide absolute inset-0 opacity-100 transition-opacity duration-700 ease-in-out">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] lg:leading-[1.12] font-display font-bold tracking-tight text-titanium">
            HUMAN INTELLIGENCE,<br />
            <span class="text-gold marker-underline">AMPLIFIED BY CODE.</span>
          </h1>
        </div>
        <div id="slide-1" class="carousel-slide absolute inset-0 opacity-0 transition-opacity duration-700 ease-in-out pointer-events-none">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] lg:leading-[1.12] font-display font-bold tracking-tight text-titanium">
            ZERO-TO-ONE VENTURES<br />
            WITH <span class="text-magenta marker-underline marker-underline-pink">DURABLE SOUL.</span>
          </h1>
        </div>
        <div id="slide-2" class="carousel-slide absolute inset-0 opacity-0 transition-opacity duration-700 ease-in-out pointer-events-none">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] lg:leading-[1.12] font-display font-bold tracking-tight text-titanium">
            FRONTIER AI, VOICE UX<br />
            & <span class="text-cyan marker-underline marker-underline-cyan">SPATIAL COMPUTING.</span>
          </h1>
        </div>
      </div>

      <!-- Navigation Indicators -->
      <div class="flex gap-2.5 mb-8" role="tablist" aria-label="Hero statements">
        <button id="dot-0" aria-label="Slide 1" class="w-10 h-1.5 rounded-full bg-gold transition-all duration-300"></button>
        <button id="dot-1" aria-label="Slide 2" class="w-10 h-1.5 rounded-full bg-charcoal hover:bg-titanium/40 transition-all duration-300"></button>
        <button id="dot-2" aria-label="Slide 3" class="w-10 h-1.5 rounded-full bg-charcoal hover:bg-titanium/40 transition-all duration-300"></button>
      </div>

      <!-- High-Conviction Executive Positioning Bio -->
      <p class="text-base sm:text-lg text-titanium/85 leading-relaxed font-light max-w-2xl mb-8">
        Advising founders, enterprise executives, and sovereign initiatives on AI strategy, product incubation, and zero-to-one venture creation. Rooted in <strong class="text-gold font-medium">10+ years pioneering Voice UX</strong>, 6 US patents, and Master's venture design (<span class="text-titanium font-medium">HEC Paris MSIE</span>).
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-4">
        <a 
          href="#strategy" 
          class="btn-primary text-xs px-7 py-3.5"
        >
          EXPLORE CAPABILITIES →
        </a>
        <a 
          href="/portfolio" 
          class="px-6 py-3.5 rounded-punk-sm border border-white/10 bg-[#12151B] text-titanium font-mono text-xs hover:border-gold/60 hover:text-gold hover:shadow-[0_4px_16px_rgba(229,184,11,0.15)] transition-all duration-200"
        >
          [ 20-YEAR WORK ARCHIVE ]
        </a>
      </div>

    </div>

    <!-- Right Column: Open Illustrated Face Stage with Luxury Telemetry Pods (5 Columns) -->
    <div class="lg:col-span-5 relative flex items-center justify-center py-6">
      
      <!-- Relative Stage for Face + Precision Telemetry Pods -->
      <div class="relative w-full max-w-[400px] flex items-center justify-center">

        <!-- Interactive Masked Line Shimmer Face Container (Clickable Toggle) -->
        <div 
          id="face-container"
          class="relative z-10 w-56 sm:w-72 md:w-80 lg:w-[340px] h-72 sm:h-88 md:h-[380px] lg:h-[420px] cursor-pointer group/face transition-transform duration-300 hover:scale-105"
          title="Click to toggle look!"
        >
          <!-- Shimmering Line Mask Element -->
          <div 
            id="face-masked-element"
            class="masked-face-shimmer"
            style="-webkit-mask-image: url('/media/illustrations/jesse-beanie-white.png'); mask-image: url('/media/illustrations/jesse-beanie-white.png');"
          ></div>
        </div>

        <!-- Precision Telemetry Pods (Reason-to-Believe HUD Metrics) -->
        
        <!-- Top-Left: 20+ YRS (Gold) -->
        <div class="telemetry-chip absolute -top-3 -left-2 sm:-left-6 z-20 border-l-2 border-l-gold">
          <div class="flex items-center gap-1.5 mb-0.5">
            <span class="w-1.5 h-1.5 rounded-full bg-gold animate-pulse"></span>
            <span class="font-mono text-[9px] text-gold tracking-widest uppercase">SYS_EXP // 01</span>
          </div>
          <span class="font-display font-bold text-xs sm:text-sm text-titanium leading-tight">
            20+ YRS FIELD PROOF
          </span>
          <span class="font-mono text-[9px] text-titanium-muted tracking-wider uppercase">
            Venture & Product
          </span>
        </div>

        <!-- Top-Right: 6 PATENTS (Cyan) -->
        <div class="telemetry-chip absolute top-4 -right-2 sm:-right-6 z-20 border-l-2 border-l-cyan">
          <div class="flex items-center gap-1.5 mb-0.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan"></span>
            <span class="font-mono text-[9px] text-cyan tracking-widest uppercase">USPTO // 02</span>
          </div>
          <span class="font-display font-bold text-xs sm:text-sm text-titanium leading-tight">
            6 US PATENTS
          </span>
          <span class="font-mono text-[9px] text-titanium-muted tracking-wider uppercase">
            Interaction & Voice IP
          </span>
        </div>

        <!-- Bottom-Left: CANNES LIONS (Hot Pink) -->
        <div class="telemetry-chip absolute bottom-8 -left-2 sm:-left-6 z-20 border-l-2 border-l-magenta">
          <div class="flex items-center gap-1.5 mb-0.5">
            <span class="w-1.5 h-1.5 rounded-full bg-magenta"></span>
            <span class="font-mono text-[9px] text-magenta tracking-widest uppercase">HONORS // 03</span>
          </div>
          <span class="font-display font-bold text-xs sm:text-sm text-titanium leading-tight">
            CANNES & CLIO
          </span>
          <span class="font-mono text-[9px] text-titanium-muted tracking-wider uppercase">
            Lions, Clio, Isaac
          </span>
        </div>

        <!-- Bottom-Right: HEC / UCSC (Acid Lime) -->
        <div class="telemetry-chip absolute bottom-0 -right-2 sm:-right-6 z-20 border-l-2 border-l-lime">
          <div class="flex items-center gap-1.5 mb-0.5">
            <span class="w-1.5 h-1.5 rounded-full bg-lime"></span>
            <span class="font-mono text-[9px] text-lime tracking-widest uppercase">ACADEMIA // 04</span>
          </div>
          <span class="font-display font-bold text-xs sm:text-sm text-titanium leading-tight">
            MSIE & MFA
          </span>
          <span class="font-mono text-[9px] text-titanium-muted tracking-wider uppercase">
            HEC Paris & UC Santa Cruz
          </span>
        </div>

        <!-- Subtle Bottom Hint Note -->
        <div class="absolute -bottom-7 left-1/2 -translate-x-1/2 z-20 hand-scribble text-xs text-gold/85 pointer-events-none whitespace-nowrap hidden sm:block rotate-[-1deg]">
          ~ click face to swap look ⤷
        </div>

      </div>

    </div>

  </div>

</section>

<!-- Client-Side Scripts for Auto-Rotating Headline Carousel & Interactive Face Mask Toggle -->
<script>
  let currentSlide = 0;
  const totalSlides = 3;
  const slideInterval = 5000;
  let intervalId: number | undefined;

  function showSlide(index: number) {
    for (let i = 0; i < totalSlides; i++) {
      const slide = document.getElementById(`slide-${i}`);
      const dot = document.getElementById(`dot-${i}`);
      
      if (slide && dot) {
        if (i === index) {
          slide.classList.remove('opacity-0', 'pointer-events-none');
          slide.classList.add('opacity-100');
          dot.classList.remove('bg-charcoal', 'hover:bg-titanium/40');
          dot.classList.add('bg-gold');
        } else {
          slide.classList.remove('opacity-100');
          slide.classList.add('opacity-0', 'pointer-events-none');
          dot.classList.remove('bg-gold');
          dot.classList.add('bg-charcoal', 'hover:bg-titanium/40');
        }
      }
    }
    currentSlide = index;
  }

  function startAutoplay() {
    if (intervalId) clearInterval(intervalId);
    intervalId = window.setInterval(() => {
      const nextIndex = (currentSlide + 1) % totalSlides;
      showSlide(nextIndex);
    }, slideInterval);
  }

  // Bind indicator clicks
  for (let i = 0; i < totalSlides; i++) {
    const dot = document.getElementById(`dot-${i}`);
    if (dot) {
      dot.addEventListener('click', () => {
        showSlide(i);
        startAutoplay();
      });
    }
  }

  // Start rotation
  startAutoplay();

  // Interactive Face Look Swap (Toggle Between Beanie and Bald Illustration Masks)
  const faceContainer = document.getElementById('face-container');
  const faceMaskedElement = document.getElementById('face-masked-element');
  
  const faceLooks = [
    '/media/illustrations/jesse-beanie-white.png',
    '/media/illustrations/jesse-bald-white.png'
  ];
  let currentLookIndex = 0;

  if (faceContainer && faceMaskedElement) {
    faceContainer.addEventListener('click', () => {
      // Toggle look
      currentLookIndex = (currentLookIndex + 1) % faceLooks.length;
      const nextMaskUrl = `url('${faceLooks[currentLookIndex]}')`;
      
      // Add slight pop animation
      faceContainer.style.transform = 'scale(0.95)';
      setTimeout(() => {
        faceMaskedElement.style.webkitMaskImage = nextMaskUrl;
        faceMaskedElement.style.maskImage = nextMaskUrl;
        faceContainer.style.transform = 'scale(1)';
      }, 150);
    });
  }
</script>
