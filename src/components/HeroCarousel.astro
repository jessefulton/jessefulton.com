---
---

<section class="max-w-7xl mx-auto px-6 pt-12 md:pt-20 pb-20 relative">
  
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    
    <!-- Left Column: Editorial Headline Carousel & Narrative (7 Columns) -->
    <div class="lg:col-span-7 flex flex-col justify-center">
      
      <!-- Eyebrow: Special Elite Stamp + Rock Salt Hand-Scribble -->
      <div class="flex items-center gap-3 mb-6 flex-wrap">
        <span class="stamp-bw">
          <span class="w-2 h-2 rounded-full bg-magenta animate-pulse inline-block mr-1"></span>
          EXECUTIVE VENTURE ARCHITECTURE
        </span>
        <span class="hand-scribble text-gold rotate-1 hidden sm:inline-block">
          ~ 20 years in tech without losing the soul
        </span>
      </div>

      <!-- Headline Area with Auto-Rotating Statements & Colored Marker Underlines -->
      <div class="relative min-h-[150px] sm:min-h-[170px] md:min-h-[190px] mb-4">
        <div id="slide-0" class="carousel-slide absolute inset-0 opacity-100 transition-opacity duration-700 ease-in-out">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.5rem] lg:leading-[1.08] font-display font-extrabold tracking-tight text-titanium">
            HUMAN INTELLIGENCE,<br />
            <span class="text-gold marker-underline">AMPLIFIED BY CODE.</span>
          </h1>
        </div>
        <div id="slide-1" class="carousel-slide absolute inset-0 opacity-0 transition-opacity duration-700 ease-in-out pointer-events-none">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.5rem] lg:leading-[1.08] font-display font-extrabold tracking-tight text-titanium">
            ZERO-TO-ONE VENTURES<br />
            WITH <span class="text-magenta marker-underline marker-underline-pink">DURABLE SOUL.</span>
          </h1>
        </div>
        <div id="slide-2" class="carousel-slide absolute inset-0 opacity-0 transition-opacity duration-700 ease-in-out pointer-events-none">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.5rem] lg:leading-[1.08] font-display font-extrabold tracking-tight text-titanium">
            FRONTIER AI, VOICE UX<br />
            & <span class="text-cyan marker-underline marker-underline-cyan">SPATIAL COMPUTING.</span>
          </h1>
        </div>
      </div>

      <!-- Navigation Indicators -->
      <div class="flex gap-2.5 mb-8" role="tablist" aria-label="Hero statements">
        <button id="dot-0" aria-label="Slide 1" class="w-10 h-1.5 rounded-full bg-gold transition-all duration-300"></button>
        <button id="dot-1" aria-label="Slide 2" class="w-10 h-1.5 rounded-full bg-charcoal hover:bg-titanium/40 transition-all duration-300"></button>
        <button id="dot-2" aria-label="Slide 3" class="w-10 h-1.5 rounded-full bg-charcoal hover:bg-titanium/40 transition-all duration-300"></button>
      </div>

      <!-- Sub-headline Narrative -->
      <p class="text-lg md:text-xl text-titanium/85 font-light leading-relaxed mb-8 max-w-2xl">
        AI isn't a recent pivot—it’s the natural evolution of <strong class="text-gold font-semibold">10+ years in Voice UX & multimodal systems</strong>, Master's-level venture design (<span class="text-titanium">HEC Paris MSIE</span>), and architecting products that elevate human agency rather than replacing it.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-4">
        <a 
          href="#strategy" 
          class="px-7 py-3.5 rounded-punk-sm bg-gold text-obsidian font-display font-extrabold text-sm tracking-wide hover:bg-gold-hover shadow-punk-gold transition-all duration-200"
        >
          EXPLORE CAPABILITIES →
        </a>
        <a 
          href="/portfolio" 
          class="px-6 py-3.5 rounded-punk-sm border border-charcoal bg-charcoal/40 text-titanium font-mono text-xs hover:border-magenta hover:text-magenta hover:shadow-punk-pink transition-all duration-200"
        >
          [ 20-YEAR WORK ARCHIVE ]
        </a>
      </div>

    </div>

    <!-- Right Column: Open Illustrated Face Stage with Overlapping 70s Stickers (5 Columns) -->
    <div class="lg:col-span-5 relative flex items-center justify-center py-6">
      
      <!-- Relative Stage for Face + Overlapping Stickers -->
      <div class="relative w-full max-w-[380px] flex items-center justify-center">

        <!-- Interactive Masked Line Shimmer Face Container (Clickable Toggle) -->
        <div 
          id="face-container"
          class="relative z-10 w-56 sm:w-72 md:w-80 lg:w-[340px] h-72 sm:h-88 md:h-[380px] lg:h-[420px] cursor-pointer group/face transition-transform duration-300 hover:scale-105"
          title="Click to toggle look!"
        >
          <!-- Shimmering Line Mask Element -->
          <div 
            id="face-masked-element"
            class="masked-face-shimmer"
            style="-webkit-mask-image: url('/media/illustrations/jesse-beanie-white.png'); mask-image: url('/media/illustrations/jesse-beanie-white.png');"
          ></div>
        </div>

        <!-- 70s Cartoon / Comic Vinyl Stickers Overlapping the Illustration -->
        
        <!-- Top-Left: 20+ YRS (Gold) -->
        <div class="comic-sticker -rotate-6 absolute -top-2 -left-2 z-20 bg-gold text-obsidian border-2 border-white/60">
          <span class="font-display font-extrabold text-xs sm:text-sm leading-none tracking-tight">
            ⚡ 20+ YRS
          </span>
          <span class="font-mono text-[9px] font-bold tracking-wider uppercase opacity-90">
            FIELD PROVEN
          </span>
        </div>

        <!-- Top-Right: 6 PATENTS (Cyan) -->
        <div class="comic-sticker rotate-6 absolute top-6 -right-2 z-20 bg-cyan text-obsidian border-2 border-white/60">
          <span class="font-display font-extrabold text-xs sm:text-sm leading-none tracking-tight">
            💥 6 PATENTS
          </span>
          <span class="font-mono text-[9px] font-bold tracking-wider uppercase opacity-90">
            USPTO INTERACTION IP
          </span>
        </div>

        <!-- Bottom-Left: CANNES LIONS (Hot Pink) -->
        <div class="comic-sticker rotate-3 absolute bottom-10 -left-2 z-20 bg-magenta text-white border-2 border-white/60">
          <span class="font-display font-extrabold text-xs sm:text-sm leading-none tracking-tight">
            🏆 CANNES
          </span>
          <span class="font-mono text-[9px] font-bold tracking-wider uppercase opacity-90">
            GOLD & SILVER LIONS
          </span>
        </div>

        <!-- Bottom-Right: HEC / UCSC (Acid Lime) -->
        <div class="comic-sticker -rotate-3 absolute bottom-2 -right-2 z-20 bg-lime text-obsidian border-2 border-white/60">
          <span class="font-display font-extrabold text-xs sm:text-sm leading-none tracking-tight">
            🎓 MSIE / MFA
          </span>
          <span class="font-mono text-[9px] font-bold tracking-wider uppercase opacity-90">
            HEC PARIS & UCSC
          </span>
        </div>

        <!-- Subtle Bottom Hint Note -->
        <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 z-20 font-marker text-xs text-gold pointer-events-none whitespace-nowrap hidden sm:block">
          ~ click face to swap look ⤷
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  // Carousel Controller
  let currentSlide = 0;
  const totalSlides = 3;
  let intervalId: number;

  function showSlide(index: number) {
    for (let i = 0; i < totalSlides; i++) {
      const slide = document.getElementById(`slide-${i}`);
      const dot = document.getElementById(`dot-${i}`);
      
      if (slide && dot) {
        if (i === index) {
          slide.classList.remove('opacity-0', 'pointer-events-none');
          slide.classList.add('opacity-100');
          dot.classList.remove('bg-charcoal');
          dot.classList.add('bg-gold');
        } else {
          slide.classList.remove('opacity-100');
          slide.classList.add('opacity-0', 'pointer-events-none');
          dot.classList.remove('bg-gold');
          dot.classList.add('bg-charcoal');
        }
      }
    }
    currentSlide = index;
  }

  function nextSlide() {
    showSlide((currentSlide + 1) % totalSlides);
  }

  function startAutoplay() {
    intervalId = window.setInterval(nextSlide, 5000);
  }

  function resetAutoplay() {
    clearInterval(intervalId);
    startAutoplay();
  }

  // Interactive Face Toggle (Beanie vs Bald mask image)
  function initFaceToggle() {
    const container = document.getElementById('face-container');
    const maskedElement = document.getElementById('face-masked-element');
    
    if (container && maskedElement) {
      let isBeanie = true;
      container.addEventListener('click', () => {
        isBeanie = !isBeanie;
        const newUrl = isBeanie 
          ? "url('/media/illustrations/jesse-beanie-white.png')" 
          : "url('/media/illustrations/jesse-bald-white.png')";
        
        maskedElement.style.webkitMaskImage = newUrl;
        maskedElement.style.maskImage = newUrl;
      });
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    for (let i = 0; i < totalSlides; i++) {
      const dot = document.getElementById(`dot-${i}`);
      if (dot) {
        dot.addEventListener('click', () => {
          showSlide(i);
          resetAutoplay();
        });
      }
    }
    startAutoplay();
    initFaceToggle();
  });
</script>
