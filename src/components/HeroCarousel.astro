---

<section class="max-w-7xl mx-auto px-6 pt-12 md:pt-16 pb-20">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    
    <!-- Left Column: Editorial Headline Carousel & Narrative -->
    <div class="lg:col-span-7 flex flex-col justify-center">
      
      <!-- Live Status Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-charcoal bg-charcoal/40 text-titanium-muted font-mono text-[11px] w-fit mb-6">
        <span class="w-2 h-2 rounded-full bg-cyan animate-pulse"></span>
        <span>EXECUTIVE INNOVATION ARCHITECTURE // 2026</span>
      </div>

      <!-- Headline Area with Auto-Rotating Statements -->
      <div class="relative min-h-[150px] sm:min-h-[170px] md:min-h-[210px] mb-6">
        <div id="slide-0" class="carousel-slide absolute inset-0 opacity-100 transition-opacity duration-700 ease-in-out">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-display font-bold tracking-tight leading-none text-titanium">
            HUMAN INTELLIGENCE,<br />
            <span class="text-gold">AMPLIFIED BY CODE.</span>
          </h1>
        </div>
        <div id="slide-1" class="carousel-slide absolute inset-0 opacity-0 transition-opacity duration-700 ease-in-out pointer-events-none">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-display font-bold tracking-tight leading-none text-titanium">
            BUILDING ZERO-TO-ONE<br />
            VENTURES WITH <span class="text-magenta">DURABLE SOUL.</span>
          </h1>
        </div>
        <div id="slide-2" class="carousel-slide absolute inset-0 opacity-0 transition-opacity duration-700 ease-in-out pointer-events-none">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-display font-bold tracking-tight leading-none text-titanium">
            BRIDGING VOICE UX,<br />
            <span class="text-cyan">STRATEGY & SYSTEMS.</span>
          </h1>
        </div>
      </div>

      <!-- Navigation Indicators -->
      <div class="flex gap-2.5 mb-8" role="tablist" aria-label="Hero statements">
        <button id="dot-0" aria-label="Slide 1" class="w-10 h-1.5 rounded-full bg-gold transition-all duration-300"></button>
        <button id="dot-1" aria-label="Slide 2" class="w-10 h-1.5 rounded-full bg-charcoal hover:bg-titanium/40 transition-all duration-300"></button>
        <button id="dot-2" aria-label="Slide 3" class="w-10 h-1.5 rounded-full bg-charcoal hover:bg-titanium/40 transition-all duration-300"></button>
      </div>

      <!-- Sub-headline Narrative -->
      <p class="text-lg md:text-xl text-titanium/85 font-light leading-relaxed mb-8 max-w-2xl">
        AI isn't a recent pivot—it’s the logical continuation of <strong class="text-gold font-semibold">10+ years in Voice UX & multimodal systems</strong>, Master's-level venture design (<span class="text-titanium">HEC Paris MSIE</span>), and building products that elevate human agency rather than replacing it.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-4">
        <a 
          href="#strategy" 
          class="px-6 py-3 rounded bg-gold text-obsidian font-display font-bold text-sm tracking-wider hover:bg-gold-hover shadow-glow-gold transition-all duration-200"
        >
          EXPLORE THE PLATFORM →
        </a>
        <a 
          href="#archive" 
          class="px-6 py-3 rounded border border-charcoal bg-charcoal/30 text-titanium font-mono text-xs hover:border-cyan hover:text-cyan transition-all duration-200"
        >
          [ VIEW 20-YEAR ARCHIVE ]
        </a>
      </div>

    </div>

    <!-- Right Column: Interactive Terminal Matrix & Proof Pod -->
    <div class="lg:col-span-5">
      <div class="rounded-xl border border-charcoal bg-charcoal/30 p-6 md:p-8 backdrop-blur-md relative overflow-hidden group hover:border-gold/40 transition-all duration-300">
        
        <!-- Header Bar of Pod -->
        <div class="flex items-center justify-between border-b border-charcoal/80 pb-4 mb-6">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-magenta/80"></span>
            <span class="w-3 h-3 rounded-full bg-gold/80"></span>
            <span class="w-3 h-3 rounded-full bg-cyan/80"></span>
          </div>
          <span class="font-mono text-[11px] text-titanium-muted">SYS_KERNEL :: METRICS_PROV</span>
        </div>

        <!-- Metric Grid -->
        <div class="grid grid-cols-2 gap-4 mb-6">
          <div class="p-4 rounded-lg bg-obsidian/80 border border-charcoal/60">
            <div class="font-mono text-2xl font-bold text-gold">20+ YRS</div>
            <div class="text-xs text-titanium-muted mt-1">Multidisciplinary Innovation</div>
          </div>
          <div class="p-4 rounded-lg bg-obsidian/80 border border-charcoal/60">
            <div class="font-mono text-2xl font-bold text-cyan">6 PATENTS</div>
            <div class="text-xs text-titanium-muted mt-1">Human-Machine Interaction</div>
          </div>
          <div class="p-4 rounded-lg bg-obsidian/80 border border-charcoal/60">
            <div class="font-mono text-2xl font-bold text-magenta">CANNES</div>
            <div class="text-xs text-titanium-muted mt-1">Gold & Silver Lions / Clios</div>
          </div>
          <div class="p-4 rounded-lg bg-obsidian/80 border border-charcoal/60">
            <div class="font-mono text-2xl font-bold text-lime">5X VELOCITY</div>
            <div class="text-xs text-titanium-muted mt-1">Frontier AI Engineering</div>
          </div>
        </div>

        <!-- Terminal Log Preview -->
        <div class="p-3.5 rounded bg-obsidian border border-charcoal font-mono text-[12px] text-titanium-muted space-y-1.5">
          <div class="text-cyan">$ jesse --inspect-pedigree</div>
          <div class="text-titanium/80">→ HEC Paris MSIE (Innovation & Entrepreneurship)</div>
          <div class="text-titanium/80">→ UCSC Digital Arts & New Media (MFA)</div>
          <div class="text-titanium/80">→ AKQA, YML, Code & Theory, Thrive AI Health</div>
          <div class="text-gold">✔ System integrity verified. Ready for zero-to-one.</div>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  // Carousel Controller
  let currentSlide = 0;
  const totalSlides = 3;
  let intervalId: number;

  function showSlide(index: number) {
    for (let i = 0; i < totalSlides; i++) {
      const slide = document.getElementById(`slide-${i}`);
      const dot = document.getElementById(`dot-${i}`);
      
      if (slide && dot) {
        if (i === index) {
          slide.classList.remove('opacity-0', 'pointer-events-none');
          slide.classList.add('opacity-100');
          dot.classList.remove('bg-charcoal');
          dot.classList.add('bg-gold');
        } else {
          slide.classList.remove('opacity-100');
          slide.classList.add('opacity-0', 'pointer-events-none');
          dot.classList.remove('bg-gold');
          dot.classList.add('bg-charcoal');
        }
      }
    }
    currentSlide = index;
  }

  function nextSlide() {
    showSlide((currentSlide + 1) % totalSlides);
  }

  function startAutoplay() {
    intervalId = window.setInterval(nextSlide, 5000);
  }

  function resetAutoplay() {
    clearInterval(intervalId);
    startAutoplay();
  }

  document.addEventListener('DOMContentLoaded', () => {
    for (let i = 0; i < totalSlides; i++) {
      const dot = document.getElementById(`dot-${i}`);
      if (dot) {
        dot.addEventListener('click', () => {
          showSlide(i);
          resetAutoplay();
        });
      }
    }
    startAutoplay();
  });
</script>
