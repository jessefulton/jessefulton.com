---
---

<section id="contact" class="section-slate border-t border-charcoal/80">
  <div class="max-w-7xl mx-auto px-6 py-20 relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Engagement Narrative -->
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3 mb-2 flex-wrap">
          <span class="stamp-bw">
            GET IN TOUCH
          </span>
          <span class="hand-scribble text-magenta text-base hidden sm:inline-block rotate-1">
            (no cold pitches, real convos only)
          </span>
        </div>
        
        <h2 class="text-3xl md:text-5xl font-display font-extrabold text-titanium tracking-tight mb-6">
          Let’s Build Something With Durable Soul.
        </h2>
        <p class="text-titanium/80 text-sm font-light leading-relaxed mb-6">
          Available for selective executive advisory, zero-to-one venture architecture, keynote speaking, and strategic innovation workshops.
        </p>

        <!-- Direct Calendar Scheduler Callout -->
        <div class="punk-panel p-6 mb-6 border border-gold/40 hover:border-gold transition-colors group">
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-xs font-bold text-gold">// DIRECT CALENDAR BOOKING</span>
            <span class="font-mono text-[10px] text-cyan font-bold px-2 py-0.5 rounded-sm bg-cyan/10 border border-cyan/30">30 MIN</span>
          </div>
          <p class="text-xs text-titanium/80 font-light leading-relaxed mb-4">
            Prefer to skip email and pick an open slot directly on the live calendar?
          </p>
          <a 
            href="/meet"
            class="btn-primary text-xs px-4 py-2.5"
          >
            SCHEDULE MEETING →
          </a>
        </div>

        <!-- Status & Privacy-Protected Contact Block -->
        <div class="punk-panel p-6 space-y-4 mb-8">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-lime"></span>
            <span class="font-mono text-xs text-titanium">LOCATION: SAN FRANCISCO BAY AREA</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-cyan"></span>
            <span class="font-mono text-xs text-titanium">FOCUS: VENTURE DESIGN & FRONTIER AI</span>
          </div>
          <div class="flex items-center gap-3 pt-2 border-t border-charcoal/80">
            <span class="w-2.5 h-2.5 rounded-full bg-magenta"></span>
            <div id="email-container" class="font-mono text-xs text-titanium">
              <button 
                id="reveal-email-btn"
                type="button" 
                class="text-gold hover:text-white underline decoration-dotted underline-offset-4 transition-colors"
              >
                [ Click to reveal direct email ]
              </button>
              <span id="email-address" class="hidden text-gold font-bold"></span>
            </div>
          </div>
        </div>

        <!-- Social & PDF Links -->
        <div class="flex flex-wrap gap-4 font-mono text-xs text-titanium-muted">
          <a href="https://linkedin.com/in/jessefulton" target="_blank" rel="noopener noreferrer" class="hover:text-gold transition-colors">
            [ LINKEDIN ↗ ]
          </a>
          <a href="https://github.com/jessefulton" target="_blank" rel="noopener noreferrer" class="hover:text-cyan transition-colors">
            [ GITHUB ↗ ]
          </a>
          <a href="/media/resume/jessefulton-resume.pdf" target="_blank" class="hover:text-magenta transition-colors">
            [ RESUME PDF ↗ ]
          </a>
        </div>
      </div>

      <!-- Right Column: Netlify-Ready Form -->
      <div class="lg:col-span-7">
        <div class="punk-panel p-8 backdrop-blur-md relative">
          
          <!-- Top Right Note with Rock Salt Hand-Scribble -->
          <div class="absolute -top-5 right-4 hand-scribble text-gold text-sm rotate-2 hidden sm:block pointer-events-none">
            ~ directly to my personal inbox ⤷
          </div>

          <form 
            name="contact" 
            method="POST" 
            data-netlify="true" 
            netlify-honeypot="bot-field"
            action="/thanks"
            class="space-y-6"
          >
            <!-- Honeypot Field for Netlify Spam Filter -->
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden">
              <label>Don’t fill this out if you're human: <input name="bot-field" /></label>
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Name Input -->
              <div>
                <label for="name" class="block font-mono text-xs text-titanium-muted mb-2 font-semibold">
                  YOUR NAME <span class="text-magenta">*</span>
                </label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  placeholder="Jane Doe" 
                  class="w-full px-4 py-3 rounded-punk-sm bg-obsidian border border-charcoal text-titanium placeholder:text-titanium-muted/30 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold text-sm font-sans transition-all"
                />
              </div>

              <!-- Email Input -->
              <div>
                <label for="email" class="block font-mono text-xs text-titanium-muted mb-2 font-semibold">
                  YOUR EMAIL <span class="text-magenta">*</span>
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  placeholder="jane@example.com" 
                  class="w-full px-4 py-3 rounded-punk-sm bg-obsidian border border-charcoal text-titanium placeholder:text-titanium-muted/30 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold text-sm font-sans transition-all"
                />
              </div>
            </div>

            <!-- Organization & Intent -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="organization" class="block font-mono text-xs text-titanium-muted mb-2 font-semibold">
                  ORGANIZATION / VENTURE
                </label>
                <input 
                  type="text" 
                  id="organization" 
                  name="organization" 
                  placeholder="Acme Corp / Stealth" 
                  class="w-full px-4 py-3 rounded-punk-sm bg-obsidian border border-charcoal text-titanium placeholder:text-titanium-muted/30 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold text-sm font-sans transition-all"
                />
              </div>

              <div>
                <label for="intent" class="block font-mono text-xs text-titanium-muted mb-2 font-semibold">
                  ENGAGEMENT TYPE
                </label>
                <select 
                  id="intent" 
                  name="intent" 
                  class="w-full px-4 py-3 rounded-punk-sm bg-obsidian border border-charcoal text-titanium focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold text-sm font-sans transition-all cursor-pointer"
                >
                  <option value="strategic-advisory" class="bg-obsidian text-titanium">Strategic Advisory & Architecture</option>
                  <option value="zero-to-one" class="bg-obsidian text-titanium">Zero-to-One Venture Incubation</option>
                  <option value="executive-workshops" class="bg-obsidian text-titanium">Executive Strategy Workshops</option>
                  <option value="speaking-keynotes" class="bg-obsidian text-titanium">Speaking & Keynotes</option>
                  <option value="general-inquiry" class="bg-obsidian text-titanium">General Collaboration</option>
                </select>
              </div>
            </div>

            <!-- Message Textarea -->
            <div>
              <label for="message" class="block font-mono text-xs text-titanium-muted mb-2 font-semibold">
                MESSAGE / WHAT ARE YOU WORKING ON? <span class="text-magenta">*</span>
              </label>
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                required 
                placeholder="Tell me about the venture, the challenge, or what you're trying to solve..." 
                class="w-full px-4 py-3 rounded-punk-sm bg-obsidian border border-charcoal text-titanium placeholder:text-titanium-muted/30 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold text-sm font-sans transition-all resize-y"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <div>
              <button 
                type="submit" 
                class="btn-primary w-full py-4 px-6 text-sm tracking-wider uppercase"
              >
                SEND MESSAGE →
              </button>
            </div>
          </form>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Obfuscated Email Reveal to prevent scraper harvesting
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('reveal-email-btn');
    const addr = document.getElementById('email-address');
    if (btn && addr) {
      btn.addEventListener('click', () => {
        const u = 'jessefulton';
        const d = 'gmail.com';
        const email = `${u}@${d}`;
        addr.textContent = email;
        addr.classList.remove('hidden');
        btn.classList.add('hidden');
        
        // Wrap in clickable mailto link
        addr.innerHTML = `<a href="mailto:${email}" class="hover:underline text-gold">${email} ↗</a>`;
      });
    }
  });
</script>
