---
---

<section id="contact" class="max-w-7xl mx-auto px-6 py-20 border-t border-charcoal">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    
    <!-- Left Column: Engagement Narrative -->
    <div class="lg:col-span-5">
      <div class="font-mono text-xs text-gold tracking-widest uppercase mb-2">
        // ENGAGEMENT & ADVISORY
      </div>
      <h2 class="text-3xl md:text-4xl font-display font-bold text-titanium tracking-tight mb-6">
        Let’s Build Something With Durable Soul.
      </h2>
      <p class="text-titanium/80 text-sm font-light leading-relaxed mb-6">
        Available for selective executive advisory, zero-to-one venture architecture, keynote speaking, and strategic innovation workshops.
      </p>

      <div class="p-6 rounded-xl border border-charcoal bg-charcoal/20 space-y-4 mb-8">
        <div class="flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-lime"></span>
          <span class="font-mono text-xs text-titanium">LOCATION: SAN FRANCISCO BAY AREA</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-cyan"></span>
          <span class="font-mono text-xs text-titanium">FOCUS: ZERO-TO-ONE & FRONTIER AI</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-gold"></span>
          <span class="font-mono text-xs text-titanium">CONTACT: JESSEFULTON@GMAIL.COM</span>
        </div>
      </div>

      <div class="flex gap-4 font-mono text-xs text-titanium-muted">
        <a href="https://linkedin.com/in/jessefulton" target="_blank" rel="noopener noreferrer" class="hover:text-gold transition-colors">
          [ LINKEDIN ]
        </a>
        <a href="https://github.com/jessefulton" target="_blank" rel="noopener noreferrer" class="hover:text-cyan transition-colors">
          [ GITHUB ]
        </a>
        <a href="/media/resume/jessefulton-resume.pdf" target="_blank" class="hover:text-magenta transition-colors">
          [ RESUME PDF ]
        </a>
      </div>
    </div>

    <!-- Right Column: Netlify-Ready Form -->
    <div class="lg:col-span-7">
      <div class="rounded-xl border border-charcoal bg-obsidian p-8 backdrop-blur-md">
        
        <form 
          name="contact" 
          method="POST" 
          data-netlify="true" 
          netlify-honeypot="bot-field"
          action="/thanks"
          class="space-y-6"
        >
          <!-- Honeypot Field for Netlify Spam Filter -->
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Don’t fill this out if you're human: <input name="bot-field" /></label>
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Name Input -->
            <div>
              <label for="name" class="block font-mono text-xs text-titanium-muted mb-2">
                NAME <span class="text-gold">*</span>
              </label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                placeholder="Jane Doe" 
                class="w-full px-4 py-3 rounded bg-charcoal/40 border border-charcoal text-titanium placeholder:text-titanium-muted/40 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold text-sm font-sans transition-all"
              />
            </div>

            <!-- Email Input -->
            <div>
              <label for="email" class="block font-mono text-xs text-titanium-muted mb-2">
                EMAIL <span class="text-gold">*</span>
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="jane@example.com" 
                class="w-full px-4 py-3 rounded bg-charcoal/40 border border-charcoal text-titanium placeholder:text-titanium-muted/40 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold text-sm font-sans transition-all"
              />
            </div>
          </div>

          <!-- Organization & Intent -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="organization" class="block font-mono text-xs text-titanium-muted mb-2">
                ORGANIZATION / VENTURE
              </label>
              <input 
                type="text" 
                id="organization" 
                name="organization" 
                placeholder="Acme Corp / Stealth" 
                class="w-full px-4 py-3 rounded bg-charcoal/40 border border-charcoal text-titanium placeholder:text-titanium-muted/40 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold text-sm font-sans transition-all"
              />
            </div>

            <div>
              <label for="intent" class="block font-mono text-xs text-titanium-muted mb-2">
                ENGAGEMENT TYPE
              </label>
              <select 
                id="intent" 
                name="intent" 
                class="w-full px-4 py-3 rounded bg-charcoal/40 border border-charcoal text-titanium focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold text-sm font-sans transition-all"
              >
                <option value="strategic-advisory" class="bg-obsidian text-titanium">Strategic Advisory & Architecture</option>
                <option value="zero-to-one" class="bg-obsidian text-titanium">Zero-to-One Venture Incubation</option>
                <option value="executive-workshops" class="bg-obsidian text-titanium">Executive Strategy Workshops</option>
                <option value="speaking-keynotes" class="bg-obsidian text-titanium">Speaking & Keynotes</option>
                <option value="general-inquiry" class="bg-obsidian text-titanium">General Collaboration</option>
              </select>
            </div>
          </div>

          <!-- Message Textarea -->
          <div>
            <label for="message" class="block font-mono text-xs text-titanium-muted mb-2">
              MISSION BRIEF / MESSAGE <span class="text-gold">*</span>
            </label>
            <textarea 
              id="message" 
              name="message" 
              rows="4" 
              required 
              placeholder="Tell me about the venture, challenge, or initiative..." 
              class="w-full px-4 py-3 rounded bg-charcoal/40 border border-charcoal text-titanium placeholder:text-titanium-muted/40 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold text-sm font-sans transition-all resize-y"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <div>
            <button 
              type="submit" 
              class="w-full py-3.5 px-6 rounded bg-gold text-obsidian font-display font-bold text-sm tracking-wider uppercase hover:bg-gold-hover shadow-glow-gold transition-all duration-200"
            >
              TRANSMIT MESSAGE // SEND BRIEF
            </button>
          </div>
        </form>

      </div>
    </div>

  </div>
</section>
