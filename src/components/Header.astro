<header class="w-full border-b border-black/40 bg-[#15181E]/90 backdrop-blur-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 py-4 flex flex-wrap justify-between items-center gap-4">
    <!-- Brand Title & Identity -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-2.5 h-2.5 rounded-full bg-magenta animate-pulse shadow-glow-pink"></div>
      <div class="font-display font-bold tracking-tight text-titanium text-base group-hover:text-gold transition-colors">
        JESSE FULTON <span class="text-gold font-mono text-xs ml-1">// 2026</span>
      </div>
      <span class="hidden md:inline-block font-mono text-[11px] text-titanium-muted tracking-wider border-l border-charcoal/80 pl-3">
        VENTURE ARCHITECT & CREATIVE CATALYST
      </span>
    </a>

    <!-- Navigation Buttons -->
    <nav class="flex items-center gap-2 sm:gap-3 flex-wrap">
      <a 
        href="/#strategy" 
        class="font-mono text-xs px-3.5 py-1.5 rounded-punk-sm border border-charcoal bg-obsidian text-titanium/85 hover:border-gold hover:text-gold transition-all duration-200"
      >
        STRATEGY
      </a>
      <a 
        href="/#systems" 
        class="font-mono text-xs px-3.5 py-1.5 rounded-punk-sm border border-charcoal bg-obsidian text-titanium/85 hover:border-cyan hover:text-cyan transition-all duration-200"
      >
        SYSTEMS
      </a>
      <a 
        href="/portfolio" 
        class="font-mono text-xs px-3.5 py-1.5 rounded-punk-sm border border-charcoal bg-obsidian text-titanium/85 hover:border-magenta hover:text-magenta transition-all duration-200"
      >
        WORK ARCHIVE
      </a>
      <a 
        href="/experience" 
        class="font-mono text-xs px-3.5 py-1.5 rounded-punk-sm border border-charcoal bg-obsidian text-titanium/85 hover:border-lime hover:text-lime transition-all duration-200"
      >
        PEDIGREE
      </a>
      <a 
        href="/#contact" 
        class="font-mono text-xs px-4 py-1.5 rounded-punk-sm border border-gold bg-gold text-obsidian font-bold hover:bg-gold-hover shadow-punk-gold transition-all duration-200"
      >
        LET'S TALK →
      </a>
    </nav>
  </div>
</header>
