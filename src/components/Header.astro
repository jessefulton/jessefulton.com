---
---

<header class="w-full border-b border-charcoal bg-obsidian/85 backdrop-blur-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-6 py-4 flex flex-wrap justify-between items-center gap-4">
    <!-- Brand Title & Identity -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-2.5 h-2.5 rounded-full bg-cyan animate-pulse"></div>
      <div class="font-display font-bold tracking-widest text-titanium text-sm group-hover:text-gold transition-colors">
        JESSE FULTON <span class="text-gold font-mono">// 01</span>
      </div>
      <span class="hidden md:inline-block font-mono text-[11px] text-titanium-muted tracking-wider border-l border-charcoal pl-3">
        CREATIVE VENTURE CATALYST
      </span>
    </a>

    <!-- Navigation Buttons -->
    <nav class="flex items-center gap-2 sm:gap-3 flex-wrap">
      <a 
        href="/#strategy" 
        class="font-mono text-xs px-3 py-1.5 rounded border border-charcoal bg-charcoal/30 text-titanium/80 hover:border-gold hover:text-gold hover:bg-gold/10 transition-all duration-200"
      >
        [ STRATEGY ]
      </a>
      <a 
        href="/#systems" 
        class="font-mono text-xs px-3 py-1.5 rounded border border-charcoal bg-charcoal/30 text-titanium/80 hover:border-cyan hover:text-cyan hover:bg-cyan/10 transition-all duration-200"
      >
        [ SYSTEMS ]
      </a>
      <a 
        href="/#archive" 
        class="font-mono text-xs px-3 py-1.5 rounded border border-charcoal bg-charcoal/30 text-titanium/80 hover:border-magenta hover:text-magenta hover:bg-magenta/10 transition-all duration-200"
      >
        [ ARCHIVE ]
      </a>
      <a 
        href="/#contact" 
        class="font-mono text-xs px-3.5 py-1.5 rounded border border-gold/40 bg-gold/10 text-gold hover:border-gold hover:bg-gold hover:text-obsidian font-semibold transition-all duration-200"
      >
        [ ENGAGE ]
      </a>
    </nav>
  </div>
</header>
