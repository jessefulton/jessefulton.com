---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="404 - Signal Not Found // Jesse Fulton"
  description="The requested route does not exist."
>
  <Header />

  <main class="flex-grow flex items-center justify-center py-24 px-6">
    <div class="max-w-xl w-full text-center punk-panel p-10 backdrop-blur-md">
      <div class="font-display text-5xl font-extrabold text-magenta mb-4 tracking-tight">
        404
      </div>

      <div class="flex items-center justify-center gap-3 mb-4 flex-wrap">
        <span class="stamp-bw">
          <span class="w-2 h-2 rounded-full bg-magenta inline-block mr-1"></span>
          SIGNAL LOST
        </span>
        <span class="hand-scribble text-magenta rotate-1 hidden sm:inline-block">
          ~ off the map
        </span>
      </div>

      <h1 class="text-2xl font-display font-bold text-titanium mb-4">
        Vector Coordinate Not Found
      </h1>

      <p class="text-titanium-muted text-sm font-light leading-relaxed mb-8">
        The requested pathway does not exist within the current system matrix.
      </p>

      <a 
        href="/" 
        class="inline-block px-7 py-3.5 rounded-punk-sm bg-gold text-obsidian font-display font-extrabold text-xs tracking-wider uppercase hover:bg-gold-hover shadow-punk-gold transition-all duration-200"
      >
        ← RETURN TO PLATFORM
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
