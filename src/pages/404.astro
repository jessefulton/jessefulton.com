---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="404 - Signal Not Found // Jesse Fulton"
  description="The requested route does not exist."
>
  <Header />

  <main class="flex-grow flex items-center justify-center py-24 px-6">
    <div class="max-w-xl w-full text-center rounded-2xl border border-charcoal bg-obsidian p-10 backdrop-blur-md">
      <div class="font-mono text-4xl font-bold text-magenta mb-4">
        404
      </div>

      <div class="font-mono text-xs text-magenta uppercase tracking-widest mb-2">
        // SIGNAL DISCONNECTED
      </div>

      <h1 class="text-2xl font-display font-bold text-titanium mb-4">
        Vector Coordinate Not Found
      </h1>

      <p class="text-titanium-muted text-sm font-light leading-relaxed mb-8">
        The requested pathway does not exist within the current system matrix.
      </p>

      <a 
        href="/" 
        class="inline-block px-6 py-3 rounded bg-charcoal/40 border border-charcoal text-titanium font-mono text-xs hover:border-gold hover:text-gold transition-all duration-200"
      >
        [ RE-ROUTE TO HOME ]
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
