<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Touch & Click Popover Handler for Mobile and Desktop
    const hudNodes = document.querySelectorAll('.hud-node');

    hudNodes.forEach(node => {
      const button = node.querySelector('button');
      const popover = node.querySelector('.hud-popover');

      if (!button || !popover) return;

      button.addEventListener('click', (e) => {
        e.stopPropagation();
        const isCurrentlyOpen = !popover.classList.contains('hidden');

        // Close all other popovers
        document.querySelectorAll('.hud-popover').forEach(p => {
          if (p !== popover) {
            p.classList.add('hidden');
          }
        });

        // Toggle current popover
        if (isCurrentlyOpen) {
          popover.classList.add('hidden');
          button.setAttribute('aria-expanded', 'false');
        } else {
          popover.classList.remove('hidden');
          button.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Close open popovers when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.hud-node')) {
        document.querySelectorAll('.hud-popover').forEach(p => {
          p.classList.add('hidden');
        });
        document.querySelectorAll('.hud-node button').forEach(b => {
          b.setAttribute('aria-expanded', 'false');
        });
      }
    });

    // Close open popover on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.hud-popover').forEach(p => {
          p.classList.add('hidden');
        });
        document.querySelectorAll('.hud-node button').forEach(b => {
          b.setAttribute('aria-expanded', 'false');
        });
      }
    });
  });
</script>
