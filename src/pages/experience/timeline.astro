---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Fetch all collections
const projects = await getCollection('projects');
const roles = await getCollection('roles');
const achievements = await getCollection('achievements');

interface TimelineItem {
  id: string;
  year: number;
  displayDate: string;
  entityType: 'role' | 'project' | 'achievement';
  typeLabel: string;
  category: 'frontier-ai' | 'venture-strategy' | 'experiential-spatial' | 'creative-tech';
  title: string;
  subtitle: string;
  briefDescription: string;
  link?: string;
  tags?: string[];
  metrics?: string[];
}

const timelineItems: TimelineItem[] = [];

// 1. Ingest Roles
roles.forEach(role => {
  if (role.data.showOnTimeline !== false) {
    timelineItems.push({
      id: `role-${role.slug}`,
      year: role.data.startYear,
      displayDate: role.data.period,
      entityType: 'role',
      typeLabel: 'CAREER LEADERSHIP',
      category: role.data.category,
      title: `${role.data.title}`,
      subtitle: `@ ${role.data.company} (${role.data.location})`,
      briefDescription: role.data.summary,
      link: `/experience#role-${role.slug}`,
      tags: role.data.highlights.slice(0, 2),
    });
  }
});

// 2. Ingest Projects
projects.forEach(project => {
  if (project.data.showOnTimeline !== false) {
    const rawYear = typeof project.data.year === 'number' ? project.data.year : parseInt(String(project.data.year)) || 2020;
    timelineItems.push({
      id: `proj-${project.slug}`,
      year: rawYear,
      displayDate: String(project.data.year),
      entityType: 'project',
      typeLabel: 'CASE STUDY',
      category: project.data.category,
      title: project.data.title,
      subtitle: project.data.client ? `Client: ${project.data.client}` : (project.data.employer ? `@ ${project.data.employer}` : project.data.role),
      briefDescription: project.data.briefDescription,
      link: `/portfolio/${project.slug}`,
      tags: project.data.tags.slice(0, 3),
      metrics: project.data.metrics?.slice(0, 2),
    });
  }
});

// 3. Ingest Achievements (Patents, Cannes, Speaking)
achievements.forEach(ach => {
  if (ach.data.showOnTimeline !== false) {
    const rawYear = typeof ach.data.year === 'number' ? ach.data.year : parseInt(String(ach.data.year)) || 2018;
    const typeLabel = ach.data.type === 'patent' ? 'US PATENT' : (ach.data.type === 'award' ? 'HONOR / AWARD' : (ach.data.type === 'speaking' ? 'KEYNOTE TALK' : 'FELLOWSHIP'));
    
    timelineItems.push({
      id: `ach-${ach.slug}`,
      year: rawYear,
      displayDate: String(ach.data.year),
      entityType: 'achievement',
      typeLabel,
      category: ach.data.category,
      title: ach.data.title,
      subtitle: ach.data.patentNumber ? `${ach.data.patentNumber} • ${ach.data.organization}` : ach.data.organization,
      briefDescription: ach.data.description,
      link: ach.data.associatedProject ? `/portfolio/${ach.data.associatedProject}` : (ach.data.link || undefined),
    });
  }
});

// Sort strictly by Year descending (then roles first if tie)
const sortedTimeline = timelineItems.sort((a, b) => {
  if (b.year !== a.year) return b.year - a.year;
  if (a.entityType === 'role') return -1;
  if (b.entityType === 'role') return 1;
  return 0;
});

const categoryThemes: Record<string, { color: string; bg: string; border: string; ring: string }> = {
  'frontier-ai': { color: 'text-cyan', bg: 'bg-cyan', border: 'border-cyan/40 bg-cyan/10', ring: 'ring-cyan/20' },
  'venture-strategy': { color: 'text-gold', bg: 'bg-gold', border: 'border-gold/40 bg-gold/10', ring: 'ring-gold/20' },
  'experiential-spatial': { color: 'text-magenta', bg: 'bg-magenta', border: 'border-magenta/40 bg-magenta/10', ring: 'ring-magenta/20' },
  'creative-tech': { color: 'text-lime', bg: 'bg-lime', border: 'border-lime/40 bg-lime/10', ring: 'ring-lime/20' },
};
---

<BaseLayout 
  title="Unified 20-Year Retrospective Timeline // Jesse Fulton"
  description="Chronological stream aggregating career positions, landmark case studies, US patents, and honors across 20 years."
>
  <Header />

  <main class="max-w-6xl mx-auto px-6 py-12 md:py-16">
    <!-- Header Section with View Switcher -->
    <header class="border-b border-charcoal pb-10 mb-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="font-mono text-xs text-cyan tracking-widest uppercase mb-2">
            // UNIFIED 20-YEAR TIMELINE STREAM
          </div>
          <h1 class="text-4xl md:text-5xl font-display font-bold text-titanium tracking-tight mb-4">
            Unified Chronology
          </h1>
          <p class="text-titanium-muted max-w-2xl text-base font-light leading-relaxed">
            Every major milestone across 20 years aggregated in chronological sequence—spanning executive roles, landmark case studies, patents, and awards.
          </p>
        </div>

        <!-- View Switcher Toggle -->
        <div class="flex bg-charcoal/40 border border-charcoal rounded-lg p-1 w-fit">
          <a 
            href="/experience" 
            class="font-mono text-xs px-4 py-2 rounded text-titanium/80 hover:text-titanium hover:bg-charcoal/50 transition-all"
          >
            [ CARDS VIEW ]
          </a>
          <a 
            href="/experience/timeline" 
            class="font-mono text-xs px-4 py-2 rounded bg-gold text-obsidian font-semibold transition-all shadow-glow-gold"
          >
            [ TIMELINE VIEW ({sortedTimeline.length}) ]
          </a>
        </div>
      </div>
    </header>

    <!-- Interactive Filter Pills -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-14">
      <div class="flex flex-wrap gap-2" id="timeline-filters">
        <button 
          data-type="all" 
          class="tl-filter-btn font-mono text-xs px-3.5 py-1.5 rounded border border-gold bg-gold text-obsidian font-semibold transition-all duration-200"
        >
          [ ALL MILESTONES ({sortedTimeline.length}) ]
        </button>
        <button 
          data-type="role" 
          class="tl-filter-btn font-mono text-xs px-3.5 py-1.5 rounded border border-charcoal bg-charcoal/30 text-titanium/80 hover:border-gold hover:text-gold transition-all duration-200"
        >
          [ 🏢 ROLES ({roles.length}) ]
        </button>
        <button 
          data-type="project" 
          class="tl-filter-btn font-mono text-xs px-3.5 py-1.5 rounded border border-charcoal bg-charcoal/30 text-titanium/80 hover:border-cyan hover:text-cyan transition-all duration-200"
        >
          [ 🚀 CASE STUDIES ({projects.length}) ]
        </button>
        <button 
          data-type="achievement" 
          class="tl-filter-btn font-mono text-xs px-3.5 py-1.5 rounded border border-charcoal bg-charcoal/30 text-titanium/80 hover:border-magenta hover:text-magenta transition-all duration-200"
        >
          [ ⚡ PATENTS & HONORS ({achievements.length}) ]
        </button>
      </div>

      <!-- Quick Search -->
      <div class="w-full sm:w-auto">
        <input 
          type="text" 
          id="timeline-search" 
          placeholder="Search timeline..." 
          class="w-full sm:w-56 px-4 py-1.5 rounded bg-charcoal/40 border border-charcoal text-titanium placeholder:text-titanium-muted/40 font-mono text-xs focus:outline-none focus:border-gold"
        />
      </div>
    </div>

    <!-- Unified Vertical Timeline Rail -->
    <section class="relative max-w-5xl mx-auto pl-6 sm:pl-8 lg:pl-0 mb-28" id="timeline-container">
      <!-- Central / Left Rail Line -->
      <div class="absolute left-6 sm:left-8 lg:left-1/2 top-4 bottom-12 w-0.5 bg-gradient-to-b from-lime via-cyan to-charcoal -translate-x-1/2"></div>

      <div class="space-y-12 lg:space-y-16">
        {sortedTimeline.map((item, idx) => {
          const isEven = idx % 2 === 0;
          const theme = categoryThemes[item.category] || { color: 'text-titanium', bg: 'bg-titanium', border: 'border-charcoal bg-charcoal/20', ring: 'ring-charcoal/40' };

          return (
            <div 
              data-entity-type={item.entityType}
              data-title={item.title.toLowerCase()}
              data-subtitle={item.subtitle.toLowerCase()}
              data-desc={item.briefDescription.toLowerCase()}
              class="timeline-node relative flex flex-col lg:flex-row items-start justify-between group transition-all duration-300"
            >
              <!-- Glowing Milestone Dot -->
              <div class={`absolute left-0 sm:left-2 lg:left-1/2 -translate-x-1/2 w-4 h-4 rounded-full ${theme.bg} border-4 border-obsidian ring-4 ${theme.ring} transition-all duration-300 group-hover:scale-125 z-10 mt-2`}></div>

              {/* Node Card - Alternating Sides on Desktop */}
              <div class={`w-full lg:w-[45%] pl-8 sm:pl-10 lg:pl-0 ${isEven ? 'lg:pr-10 lg:text-right' : 'lg:order-2 lg:pl-10 lg:text-left'}`}>
                
                <div class="rounded-xl border border-charcoal bg-charcoal/20 p-6 backdrop-blur-sm group-hover:border-gold/50 group-hover:bg-charcoal/35 transition-all duration-200">
                  
                  <!-- Top Badge Line -->
                  <div class={`flex flex-wrap items-center gap-2 mb-3 ${isEven ? 'lg:justify-end' : 'lg:justify-start'}`}>
                    <span class={`font-mono text-[10px] px-2.5 py-0.5 rounded border ${theme.border} ${theme.color} font-semibold`}>
                      {item.typeLabel}
                    </span>
                    <span class="font-mono text-xs font-bold text-titanium px-2 py-0.5 rounded bg-obsidian border border-charcoal">
                      {item.displayDate}
                    </span>
                  </div>

                  <!-- Title -->
                  <h3 class="text-xl font-display font-bold text-titanium mb-1 group-hover:text-gold transition-colors">
                    {item.title}
                  </h3>

                  <!-- Subtitle -->
                  <div class="font-mono text-xs text-titanium-muted mb-3">
                    {item.subtitle}
                  </div>

                  <!-- Brief Description -->
                  <p class="text-xs sm:text-sm text-titanium/80 font-light leading-relaxed mb-4">
                    {item.briefDescription}
                  </p>

                  <!-- Metrics / Tags -->
                  {item.metrics && item.metrics.length > 0 && (
                    <div class={`flex flex-wrap gap-1.5 mb-3 ${isEven ? 'lg:justify-end' : 'lg:justify-start'}`}>
                      {item.metrics.map(m => (
                        <span class="font-mono text-[10px] px-2 py-0.5 rounded bg-obsidian border border-cyan/30 text-cyan">
                          ⚡ {m}
                        </span>
                      ))}
                    </div>
                  )}

                  <!-- Action Link -->
                  {item.link && (
                    <div class={`pt-3 border-t border-charcoal/50 flex ${isEven ? 'lg:justify-end' : 'lg:justify-start'}`}>
                      <a 
                        href={item.link} 
                        class="font-mono text-xs text-gold hover:text-white transition-colors flex items-center gap-1.5"
                      >
                        <span>[ {item.entityType === 'project' ? 'VIEW CASE STUDY' : (item.entityType === 'role' ? 'VIEW ROLE DETAILS' : 'VIEW DETAILS')} → ]</span>
                      </a>
                    </div>
                  )}

                </div>
              </div>

              {/* Spacer Column for Alternate Side */}
              <div class={`hidden lg:block lg:w-[45%] ${isEven ? 'lg:order-2' : 'lg:order-1'}`}></div>

            </div>
          );
        })}
      </div>
    </section>

    <!-- Empty Filter State -->
    <div id="no-tl-results" class="hidden text-center py-20">
      <div class="font-mono text-xs text-magenta mb-2">// NO MATCHING TIMELINE RECORDS</div>
      <p class="text-titanium-muted text-sm">Try searching for a different keyword or select another filter.</p>
    </div>

  </main>

  <Footer />
</BaseLayout>

<script>
  // Real-time timeline filter & search
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.tl-filter-btn');
    const searchInput = document.getElementById('timeline-search') as HTMLInputElement | null;
    const nodes = document.querySelectorAll('.timeline-node') as NodeListOf<HTMLElement>;
    const noResults = document.getElementById('no-tl-results');

    let activeType = 'all';
    let searchQuery = '';

    function updateTimeline() {
      let visibleCount = 0;

      nodes.forEach(node => {
        const entityType = node.dataset.entityType || '';
        const title = node.dataset.title || '';
        const subtitle = node.dataset.subtitle || '';
        const desc = node.dataset.desc || '';

        const matchesType = activeType === 'all' || entityType === activeType;
        const matchesSearch = searchQuery === '' || 
          title.includes(searchQuery) || 
          subtitle.includes(searchQuery) || 
          desc.includes(searchQuery);

        if (matchesType && matchesSearch) {
          node.classList.remove('hidden');
          visibleCount++;
        } else {
          node.classList.add('hidden');
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('bg-gold', 'text-obsidian', 'border-gold', 'font-semibold');
          b.classList.add('border-charcoal', 'bg-charcoal/30', 'text-titanium/80');
        });

        btn.classList.remove('border-charcoal', 'bg-charcoal/30', 'text-titanium/80');
        btn.classList.add('bg-gold', 'text-obsidian', 'border-gold', 'font-semibold');

        activeType = btn.getAttribute('data-type') || 'all';
        updateTimeline();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        updateTimeline();
      });
    }
  });
</script>
