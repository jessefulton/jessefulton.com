---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="Transmission Received // Jesse Fulton"
  description="Your message has been received."
>
  <Header />

  <main class="flex-grow flex items-center justify-center py-24 px-6">
    <div class="max-w-xl w-full text-center rounded-2xl border border-charcoal bg-obsidian p-10 backdrop-blur-md">
      <div class="w-12 h-12 rounded-full bg-gold/10 border border-gold/40 text-gold flex items-center justify-center mx-auto mb-6 font-mono text-xl">
        ✔
      </div>

      <div class="font-mono text-xs text-gold uppercase tracking-widest mb-2">
        // TRANSMISSION SUCCESSFUL
      </div>

      <h1 class="text-3xl font-display font-bold text-titanium mb-4">
        Message Received.
      </h1>

      <p class="text-titanium/80 text-sm font-light leading-relaxed mb-8">
        Thank you for reaching out. I review incoming mission briefs and strategic inquiries promptly and will be in touch shortly.
      </p>

      <a 
        href="/" 
        class="inline-block px-6 py-3 rounded bg-gold text-obsidian font-display font-bold text-sm tracking-wider uppercase hover:bg-gold-hover shadow-glow-gold transition-all duration-200"
      >
        ← RETURN TO PLATFORM
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
