---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const projects = await getCollection('projects');
const sortedProjects = projects
  .filter(p => !p.data.unlisted)
  .sort((a, b) => {
    const yearA = typeof a.data.year === 'number' ? a.data.year : parseInt(String(a.data.year)) || 2020;
    const yearB = typeof b.data.year === 'number' ? b.data.year : parseInt(String(b.data.year)) || 2020;
    return yearB - yearA;
  });

const categoryConfig: Record<string, { label: string; color: string; border: string }> = {
  'frontier-ai': { label: 'FRONTIER AI', color: 'text-cyan', border: 'border-cyan/40 bg-cyan/10' },
  'venture-strategy': { label: 'VENTURE & STRATEGY', color: 'text-gold', border: 'border-gold/40 bg-gold/10' },
  'experiential-spatial': { label: 'EXPERIENTIAL & SPATIAL', color: 'text-magenta', border: 'border-magenta/40 bg-magenta/10' },
  'creative-tech': { label: 'CREATIVE TECH', color: 'text-lime', border: 'border-lime/40 bg-lime/10' },
};
---

<BaseLayout 
  title="Archive & Work Retrospective // Jesse Fulton"
  description="Filterable archive of 30+ case studies, ventures, and experimental systems spanning 2004–2026."
>
  <Header />

  <main class="max-w-6xl mx-auto px-6 py-12 md:py-16">
    <!-- Header Section following consistent pattern -->
    <header class="border-b border-charcoal/80 pb-10 mb-12">
      <div class="font-mono text-xs text-cyan font-bold tracking-widest uppercase mb-2">
        // COMPLETE ARCHIVE // 2004–2026 WORK CATALOG
      </div>
      <h1 class="text-4xl md:text-5xl font-display font-extrabold text-titanium tracking-tight mb-4">
        Project & Venture Catalog
      </h1>
      <p class="text-titanium-muted max-w-2xl text-base font-light leading-relaxed">
        A searchable, filterable retrospective of executive client engagements, conversational AI companions, developer platforms, and spatial interactive installations.
      </p>
    </header>

    <!-- Filter Controls & Search Bar -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-12">
      <!-- Domain Filter Tabs -->
      <div class="flex flex-wrap gap-2" id="filter-tabs">
        <button 
          data-filter="all" 
          class="filter-btn font-mono text-xs px-3.5 py-1.5 rounded-punk-sm border border-gold bg-gold text-obsidian font-bold shadow-punk-gold transition-all duration-200"
        >
          ALL ({sortedProjects.length})
        </button>
        <button 
          data-filter="frontier-ai" 
          class="filter-btn font-mono text-xs px-3.5 py-1.5 rounded-punk-sm border border-charcoal bg-obsidian text-titanium/80 hover:border-cyan hover:text-cyan transition-all duration-200"
        >
          FRONTIER AI
        </button>
        <button 
          data-filter="venture-strategy" 
          class="filter-btn font-mono text-xs px-3.5 py-1.5 rounded-punk-sm border border-charcoal bg-obsidian text-titanium/80 hover:border-gold hover:text-gold transition-all duration-200"
        >
          VENTURE & STRATEGY
        </button>
        <button 
          data-filter="experiential-spatial" 
          class="filter-btn font-mono text-xs px-3.5 py-1.5 rounded-punk-sm border border-charcoal bg-obsidian text-titanium/80 hover:border-magenta hover:text-magenta transition-all duration-200"
        >
          EXPERIENTIAL & SPATIAL
        </button>
        <button 
          data-filter="creative-tech" 
          class="filter-btn font-mono text-xs px-3.5 py-1.5 rounded-punk-sm border border-charcoal bg-obsidian text-titanium/80 hover:border-lime hover:text-lime transition-all duration-200"
        >
          CREATIVE TECH
        </button>
      </div>

      <!-- Quick Search Bar -->
      <div class="w-full sm:w-auto">
        <input 
          type="text" 
          id="archive-search" 
          placeholder="Filter by keyword or tag..." 
          class="w-full sm:w-64 px-4 py-2.5 rounded-punk-sm bg-obsidian border border-charcoal text-titanium placeholder:text-titanium-muted/40 font-mono text-xs focus:outline-none focus:border-gold"
        />
      </div>
    </div>

    <!-- Archive Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
      {sortedProjects.map((project) => {
        const cat = categoryConfig[project.data.category] || { label: project.data.category, color: 'text-titanium', border: 'border-charcoal bg-charcoal/20' };
        const thumbnail = project.data.heroImage || project.data.gallery?.[0];

        return (
          <a 
            href={`/portfolio/${project.slug}`}
            data-category={project.data.category}
            data-tags={project.data.tags.join(' ').toLowerCase()}
            data-title={project.data.title.toLowerCase()}
            class="project-card punk-panel rounded-punk-sm overflow-hidden transition-all duration-300 flex flex-col justify-between group"
          >
            <div>
              <!-- Visual Hero Thumbnail -->
              {thumbnail ? (
                <div class="w-full aspect-video overflow-hidden bg-obsidian border-b border-charcoal/80 relative">
                  <img 
                    src={thumbnail} 
                    alt={project.data.title} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-obsidian/90 via-transparent to-transparent"></div>
                  <div class="absolute bottom-2 left-3 font-mono text-[10px] font-bold px-2 py-0.5 rounded-sm bg-obsidian/90 border border-charcoal/80 text-gold backdrop-blur-sm">
                    {project.data.year}
                  </div>
                </div>
              ) : (
                <div class="w-full aspect-video bg-charcoal-washed border-b border-charcoal/80 flex items-center justify-center relative p-6">
                  <div class="font-mono text-xs text-titanium-muted/60 uppercase tracking-widest text-center">
                    // {cat.label}
                  </div>
                  <div class="absolute bottom-2 left-3 font-mono text-[10px] font-bold px-2 py-0.5 rounded-sm bg-obsidian/90 border border-charcoal/80 text-gold backdrop-blur-sm">
                    {project.data.year}
                  </div>
                </div>
              )}

              <div class="p-6">
                <!-- Top Metadata -->
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class={`font-mono text-[10px] font-bold px-2.5 py-0.5 rounded-sm border ${cat.border} ${cat.color} uppercase tracking-wider`}>
                    {cat.label}
                  </span>
                  {project.data.client && (
                    <span class="font-mono text-[11px] text-titanium-muted truncate max-w-[140px]">
                      {project.data.client}
                    </span>
                  )}
                </div>

                <!-- Title & Byline -->
                <h2 class="text-xl font-display font-bold text-titanium mb-2 group-hover:text-gold transition-colors line-clamp-2">
                  {project.data.title}
                </h2>

                <!-- Description -->
                <p class="text-xs text-titanium/80 font-light leading-relaxed line-clamp-3 mb-4">
                  {project.data.briefDescription}
                </p>
              </div>
            </div>

            <!-- Footer / Tags -->
            <div class="px-6 pb-6 pt-2 border-t border-charcoal/50">
              <div class="flex flex-wrap gap-1.5 mb-3">
                {project.data.tags.slice(0, 3).map(tag => (
                  <span class="font-mono text-[10px] px-2 py-0.5 rounded-sm bg-obsidian border border-charcoal text-titanium-muted">
                    #{tag}
                  </span>
                ))}
              </div>

              <div class="flex items-center justify-between text-xs font-mono text-titanium-muted pt-2 border-t border-charcoal/30">
                <span class="text-gold font-bold group-hover:underline">VIEW STUDY →</span>
                <span class="text-[10px]">{project.data.year}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Empty Results Fallback -->
    <div id="no-results" class="hidden text-center py-20 border border-dashed border-charcoal rounded-punk-sm my-8">
      <div class="font-mono text-sm text-gold mb-2">// NO MATCHING CASE STUDIES FOUND</div>
      <p class="text-xs text-titanium-muted">Try refining your keyword search or switching domain filters.</p>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  function initFilters() {
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.project-card') as NodeListOf<HTMLElement>;
    const searchInput = document.getElementById('archive-search') as HTMLInputElement | null;
    const noResults = document.getElementById('no-results');

    let activeFilter = 'all';
    let searchQuery = '';

    function applyFilter() {
      let visibleCount = 0;

      cards.forEach(card => {
        const category = card.getAttribute('data-category') || '';
        const tags = card.getAttribute('data-tags') || '';
        const title = card.getAttribute('data-title') || '';

        const matchesCategory = activeFilter === 'all' || category === activeFilter;
        const matchesSearch = !searchQuery || 
          title.includes(searchQuery) || 
          tags.includes(searchQuery) || 
          category.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => {
          b.classList.remove('border-gold', 'bg-gold', 'text-obsidian', 'shadow-punk-gold', 'font-bold');
          b.classList.add('border-charcoal', 'bg-obsidian', 'text-titanium/80');
        });

        btn.classList.remove('border-charcoal', 'bg-obsidian', 'text-titanium/80');
        btn.classList.add('border-gold', 'bg-gold', 'text-obsidian', 'shadow-punk-gold', 'font-bold');

        activeFilter = btn.getAttribute('data-filter') || 'all';
        applyFilter();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        applyFilter();
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initFilters);
  initFilters();
</script>
