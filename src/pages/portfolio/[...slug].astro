---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCarousel from '../../components/ProjectCarousel.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const categoryLabels: Record<string, { label: string; color: string; border: string; bg: string }> = {
  'frontier-ai': { 
    label: 'FRONTIER AI & VELOCITY', 
    color: 'text-cyan', 
    border: 'border-cyan/40', 
    bg: 'bg-cyan/10' 
  },
  'venture-strategy': { 
    label: 'VENTURE & PRODUCT STRATEGY', 
    color: 'text-gold', 
    border: 'border-gold/40', 
    bg: 'bg-gold/10' 
  },
  'experiential-spatial': { 
    label: 'EXPERIENTIAL & SPATIAL UX', 
    color: 'text-magenta', 
    border: 'border-magenta/40', 
    bg: 'bg-magenta/10' 
  },
  'creative-tech': { 
    label: 'CREATIVE COMPUTATION & ART', 
    color: 'text-lime', 
    border: 'border-lime/40', 
    bg: 'bg-lime/10' 
  },
};

const catInfo = categoryLabels[entry.data.category] || { 
  label: entry.data.category.toUpperCase(), 
  color: 'text-titanium', 
  border: 'border-charcoal', 
  bg: 'bg-charcoal/20' 
};

// Filter out broken / missing asset references to guarantee clean media render
const galleryImages = (entry.data.gallery || []).filter(img => img && !img.includes('undefined') && !img.includes('null'));
const hasMedia = !!entry.data.cloudinaryVideo || !!entry.data.heroImage || galleryImages.length > 0;
---

<BaseLayout 
  title={`${entry.data.title} // Jesse Fulton`}
  description={entry.data.briefDescription}
>
  <Header />

  <main class="max-w-6xl mx-auto px-6 py-12 md:py-16">
    <!-- Breadcrumb -->
    <nav class="mb-8 font-mono text-xs text-titanium-muted flex items-center gap-2">
      <a href="/" class="hover:text-gold transition-colors">HOME</a>
      <span>/</span>
      <a href="/portfolio" class="hover:text-gold transition-colors">ARCHIVE</a>
      <span>/</span>
      <span class="text-titanium">{entry.data.title}</span>
    </nav>

    <!-- Master Unified Layout Grid: Sidebar Aligned to Page Heading Top -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      
      <!-- Left Spine: Header + Media + Narrative (8 Columns) -->
      <div class="lg:col-span-8 flex flex-col">
        
        <!-- Case Study Header -->
        <header class="border-b border-charcoal/80 pb-8 mb-10">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-bold text-titanium tracking-tight mb-4">
            {entry.data.title}
          </h1>

          {entry.data.byline && (
            <p class="text-xl md:text-2xl text-gold font-sans font-light leading-relaxed mb-5">
              {entry.data.byline}
            </p>
          )}

          <p class="text-base sm:text-lg text-titanium/85 font-light leading-relaxed mb-6">
            {entry.data.briefDescription}
          </p>

          <!-- Provenance Metadata -->
          <div class="pt-4 border-t border-charcoal/60 flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
            <span class="text-titanium-muted">CASE RETROSPECTIVE</span>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-gold animate-pulse"></span>
              <span class="text-gold uppercase tracking-wider font-semibold">
                // {catInfo.label} // {entry.data.year}
              </span>
            </div>
          </div>
        </header>

        <!-- Media Reel Carousel (Inside Left Spine) -->
        {hasMedia && (
          <section class="mb-12">
            <ProjectCarousel 
              videoUrl={entry.data.cloudinaryVideo}
              poster={entry.data.heroImage}
              images={galleryImages} 
              title={entry.data.title} 
            />
          </section>
        )}

        <!-- Main Narrative Body with 8px Baseline Vertical Rhythm -->
        <article class="prose-editorial max-w-none">
          <Content />
        </article>

      </div>

      <!-- Right Column: Specifications Sidebar (Aligned with Heading from Top) -->
      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
        <div class="rounded-xl border border-charcoal bg-charcoal/20 p-6 backdrop-blur-sm space-y-6">
          <div class="font-mono text-xs text-gold uppercase tracking-wider pb-3 border-b border-charcoal/80 flex items-center justify-between">
            <span>// PROJECT SPECS</span>
            <span>SYS_METADATA</span>
          </div>

          <!-- Client / Brand Partner -->
          {entry.data.client && (
            <div>
              <div class="font-mono text-[11px] text-titanium-muted uppercase mb-1">Client / Partner</div>
              <div class="text-sm font-semibold text-gold">{entry.data.client}</div>
            </div>
          )}

          <!-- Role -->
          <div>
            <div class="font-mono text-[11px] text-titanium-muted uppercase mb-1">Role & Responsibility</div>
            <div class="text-sm font-semibold text-titanium">{entry.data.role}</div>
          </div>

          <!-- Employer / Agency -->
          {entry.data.employer && (
            <div>
              <div class="font-mono text-[11px] text-titanium-muted uppercase mb-1">Organization / Agency</div>
              <div class="text-sm text-titanium">{entry.data.employer}</div>
            </div>
          )}

          <!-- Key Metrics -->
          {entry.data.metrics && entry.data.metrics.length > 0 && (
            <div>
              <div class="font-mono text-[11px] text-titanium-muted uppercase mb-2">Key Metrics & Impact</div>
              <div class="space-y-1.5">
                {entry.data.metrics.map(m => (
                  <div class="font-mono text-xs px-2.5 py-1 rounded bg-obsidian border border-charcoal text-cyan flex items-center gap-2">
                    <span class="text-cyan">▹</span> {m}
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Honors & Recognition -->
          {entry.data.achievements && entry.data.achievements.length > 0 && (
            <div>
              <div class="font-mono text-[11px] text-titanium-muted uppercase mb-2">Recognition & Patents</div>
              <div class="space-y-1.5">
                {entry.data.achievements.map(a => (
                  <div class="font-mono text-xs px-2.5 py-1 rounded bg-obsidian border border-gold/40 text-gold flex items-center gap-2">
                    <span>★</span> {a}
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Industries -->
          {entry.data.industries && entry.data.industries.length > 0 && (
            <div>
              <div class="font-mono text-[11px] text-titanium-muted uppercase mb-1">Domain & Industries</div>
              <div class="flex flex-wrap gap-1">
                {entry.data.industries.map(ind => (
                  <span class="font-mono text-[11px] px-2 py-0.5 rounded bg-charcoal/40 text-titanium-muted">
                    {ind}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Technical Capabilities Tags (Linked to /tags/[tag]) -->
          {entry.data.tags && entry.data.tags.length > 0 && (
            <div>
              <div class="font-mono text-[11px] text-titanium-muted uppercase mb-1">Technical Capabilities</div>
              <div class="flex flex-wrap gap-1.5 pt-1">
                {entry.data.tags.map(tag => {
                  const tagSlug = tag.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
                  return (
                    <a 
                      href={`/tags/${tagSlug}`}
                      class="font-mono text-[11px] px-2.5 py-1 rounded bg-obsidian border border-charcoal/80 text-titanium-muted hover:border-gold hover:text-gold hover:bg-gold/10 transition-all duration-150 inline-block"
                      title={`View all ${tag} case studies`}
                    >
                      #{tag}
                    </a>
                  );
                })}
              </div>
            </div>
          )}

          <!-- Deliverables / Artifacts -->
          {entry.data.deliverables && entry.data.deliverables.length > 0 && (
            <div>
              <div class="font-mono text-[11px] text-titanium-muted uppercase mb-1">Key Deliverables</div>
              <div class="flex flex-wrap gap-1">
                {entry.data.deliverables.map(del => (
                  <span class="font-mono text-[11px] px-2 py-0.5 rounded bg-obsidian border border-charcoal text-titanium/80">
                    {del}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Direct Live Links -->
          {entry.data.liveUrl && (
            <div class="pt-4 border-t border-charcoal/80">
              <a 
                href={entry.data.liveUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-primary w-full text-center text-xs py-2.5"
              >
                VISIT LIVE SYSTEM ↗
              </a>
            </div>
          )}

        </div>
      </aside>

    </div>

    <!-- Related Navigation Footer -->
    <div class="mt-16 pt-8 border-t border-charcoal/80 flex items-center justify-between font-mono text-xs">
      <a href="/portfolio" class="text-titanium-muted hover:text-gold transition-colors flex items-center gap-2">
        <span>←</span> BACK TO COMPLETE CATALOG
      </a>
      <a href="#top" class="text-titanium-muted hover:text-gold transition-colors">
        ↑ TOP OF CASE STUDY
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
