---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCarousel from '../../components/ProjectCarousel.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const categoryLabels: Record<string, { label: string; color: string; border: string }> = {
  'frontier-ai': { label: 'FRONTIER AI & SYSTEMS', color: 'text-cyan', border: 'border-cyan/40 bg-cyan/10' },
  'venture-strategy': { label: 'VENTURE & PRODUCT STRATEGY', color: 'text-gold', border: 'border-gold/40 bg-gold/10' },
  'experiential-spatial': { label: 'EXPERIENTIAL & SPATIAL', color: 'text-magenta', border: 'border-magenta/40 bg-magenta/10' },
  'creative-tech': { label: 'CREATIVE TECH & ART', color: 'text-lime', border: 'border-lime/40 bg-lime/10' },
};

const catInfo = categoryLabels[entry.data.category] || { label: entry.data.category, color: 'text-titanium', border: 'border-charcoal bg-charcoal/20' };

// Collect gallery images
const galleryImages: string[] = [];
if (entry.data.heroImage) galleryImages.push(entry.data.heroImage);
if (entry.data.gallery && Array.isArray(entry.data.gallery)) {
  entry.data.gallery.forEach(img => {
    if (!galleryImages.includes(img)) galleryImages.push(img);
  });
}

const hasMedia = Boolean(entry.data.cloudinaryVideo || galleryImages.length > 0);

// Query all projects for previous/next navigation
const allProjects = await getCollection('projects');
const currentIndex = allProjects.findIndex(p => p.slug === entry.slug);
const prevProject = currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const nextProject = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;
---

<BaseLayout 
  title={`${entry.data.title} // Jesse Fulton`}
  description={entry.data.briefDescription}
>
  <Header />

  <main class="max-w-6xl mx-auto px-6 py-12 md:py-16">
    <!-- Breadcrumb -->
    <nav class="mb-8 font-mono text-xs text-titanium-muted flex items-center gap-2">
      <a href="/" class="hover:text-gold transition-colors">HOME</a>
      <span>/</span>
      <a href="/portfolio" class="hover:text-gold transition-colors">ARCHIVE</a>
      <span>/</span>
      <span class="text-titanium">{entry.data.title}</span>
    </nav>

    <!-- Case Study Header with Stamp + Rock Salt Scribble Pairing -->
    <header class="border-b border-charcoal/80 pb-10 mb-12">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="stamp-bw">
          <span class="w-2 h-2 rounded-full bg-gold inline-block mr-1"></span>
          {catInfo.label}
        </span>
        <span class="hand-scribble text-gold rotate-1 hidden sm:inline-block">
          ~ {entry.data.year}{entry.data.client ? ` · ${entry.data.client}` : entry.data.employer ? ` · ${entry.data.employer}` : ''}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-bold text-titanium tracking-tight mb-4">
        {entry.data.title}
      </h1>

      {entry.data.byline && (
        <p class="text-xl md:text-2xl text-gold font-sans font-light leading-relaxed mb-6">
          {entry.data.byline}
        </p>
      )}

      <p class="text-lg text-titanium/80 font-light leading-relaxed max-w-4xl">
        {entry.data.briefDescription}
      </p>
    </header>

    <!-- Unified Media Carousel Section (Video Reel First + Images) -->
    {hasMedia && (
      <section class="mb-12">
        <ProjectCarousel 
          videoUrl={entry.data.cloudinaryVideo}
          poster={entry.data.heroImage}
          images={galleryImages} 
          title={entry.data.title} 
        />
      </section>
    )}

    <!-- Content Grid (Body + Specs Sidebar) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Main Narrative Body with 8px Baseline Vertical Rhythm -->
      <article class="lg:col-span-8 prose-editorial max-w-none">
        <Content />
      </article>

      <!-- Specifications Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="rounded-xl border border-charcoal bg-charcoal/20 p-6 backdrop-blur-sm space-y-6 sticky top-24">
          <div class="font-mono text-xs text-gold uppercase tracking-wider pb-3 border-b border-charcoal/80 flex items-center justify-between">
            <span>// PROJECT SPECS</span>
            <span>SYS_METADATA</span>
          </div>

          <!-- Role -->
          <div>
            <div class="font-mono text-[11px] text-titanium-muted uppercase mb-1">Role & Responsibility</div>
            <div class="text-sm font-semibold text-titanium">{entry.data.role}</div>
          </div>

          <!-- Employer / Org -->
          {entry.data.employer && (
            <div>
              <div class="font-mono text-[11px] text-titanium-muted uppercase mb-1">Organization / Agency</div>
              <div class="text-sm text-titanium">{entry.data.employer}</div>
            </div>
          )}

          <!-- Key Metrics -->
          {entry.data.metrics && entry.data.metrics.length > 0 && (
            <div>
              <div class="font-mono text-[11px] text-titanium-muted uppercase mb-2">Key Metrics & Impact</div>
              <div class="space-y-1.5">
                {entry.data.metrics.map(m => (
                  <div class="font-mono text-xs px-2.5 py-1 rounded bg-obsidian border border-charcoal text-cyan flex items-center gap-2">
                    <span>⚡</span> {m}
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Honors & Recognition -->
          {entry.data.achievements && entry.data.achievements.length > 0 && (
            <div>
              <div class="font-mono text-[11px] text-titanium-muted uppercase mb-2">Recognition & Patents</div>
              <div class="space-y-1.5">
                {entry.data.achievements.map(a => (
                  <div class="font-mono text-xs px-2.5 py-1 rounded bg-obsidian border border-gold/40 text-gold flex items-center gap-2">
                    <span>★</span> {a}
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Industries -->
          {entry.data.industries && entry.data.industries.length > 0 && (
            <div>
              <div class="font-mono text-[11px] text-titanium-muted uppercase mb-1">Domain & Industries</div>
              <div class="flex flex-wrap gap-1">
                {entry.data.industries.map(ind => (
                  <span class="font-mono text-[11px] px-2 py-0.5 rounded bg-charcoal/40 text-titanium-muted">
                    {ind}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Tags -->
          <div>
            <div class="font-mono text-[11px] text-titanium-muted uppercase mb-2">Technical Capabilities</div>
            <div class="flex flex-wrap gap-1.5">
              {entry.data.tags.map(t => {
                const tagSlug = t.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
                return (
                  <a 
                    href={`/tags/${tagSlug}`}
                    class="font-mono text-xs px-2.5 py-1 rounded-sm bg-obsidian border border-charcoal text-titanium-muted hover:border-gold hover:text-gold hover:bg-gold/10 transition-colors"
                  >
                    #{t}
                  </a>
                );
              })}
            </div>
          </div>

          <!-- External Links / Primary Link -->
          {entry.data.primaryLink && (
            <div class="pt-4 border-t border-charcoal/60">
              <a 
                href={entry.data.primaryLink} 
                target="_blank" 
                rel="noopener noreferrer"
                class="font-mono text-xs px-4 py-2.5 rounded bg-gold text-obsidian font-semibold hover:bg-gold-hover transition-colors flex items-center justify-center gap-2 w-full shadow-glow-gold"
              >
                <span>OPEN EXTERNAL SYSTEM</span>
                <span>↗</span>
              </a>
            </div>
          )}
        </div>
      </aside>

    </div>

    <!-- Bottom Navigation (Previous / Next Case Study) -->
    <nav class="border-t border-charcoal mt-20 pt-10 grid grid-cols-1 sm:grid-cols-2 gap-6">
      {prevProject ? (
        <a 
          href={`/portfolio/${prevProject.slug}`} 
          class="rounded-xl border border-charcoal bg-charcoal/20 p-6 hover:border-gold/50 transition-colors group text-left"
        >
          <div class="font-mono text-xs text-titanium-muted mb-1">← PREVIOUS CASE STUDY</div>
          <div class="font-display font-bold text-lg text-titanium group-hover:text-gold transition-colors">{prevProject.data.title}</div>
        </a>
      ) : <div />}

      {nextProject ? (
        <a 
          href={`/portfolio/${nextProject.slug}`} 
          class="rounded-xl border border-charcoal bg-charcoal/20 p-6 hover:border-gold/50 transition-colors group text-right sm:col-start-2"
        >
          <div class="font-mono text-xs text-titanium-muted mb-1">NEXT CASE STUDY →</div>
          <div class="font-display font-bold text-lg text-titanium group-hover:text-gold transition-colors">{nextProject.data.title}</div>
        </a>
      ) : <div />}
    </nav>

  </main>

  <Footer />
</BaseLayout>
